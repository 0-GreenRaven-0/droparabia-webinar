---
interface Props {
  targetDate: string;
}
const { targetDate } = Astro.props;
---

<div class="countdown-widget flex items-center gap-3 font-[IBrand]">
  <div class="flex flex-col items-center">
    <span class="text-3xl lg:text-4xl text-black cd-days">00</span>
    <span class="cd-label text-xs text-black uppercase">Days</span>
  </div>
  <span class="text-2xl lg:text-3xl text-black mb-2">:</span>
  <div class="flex flex-col items-center">
    <span class="text-3xl lg:text-4xl text-black cd-hours">00</span>
    <span class="cd-label text-xs text-black uppercase">Hours</span>
  </div>
  <span class="text-2xl lg:text-3xl text-black mb-2">:</span>
  <div class="flex flex-col items-center">
    <span class="text-3xl lg:text-4xl text-black cd-minutes">00</span>
    <span class="cd-label text-xs text-black uppercase">Minutes</span>
  </div>
  <span class="text-2xl lg:text-3xl text-black mb-2">:</span>
  <div class="flex flex-col items-center">
    <span class="text-3xl lg:text-4xl text-black cd-seconds">00</span>
    <span class="cd-label text-xs text-black uppercase">Seconds</span>
  </div>
</div>

<style>
  /* Lighter than the IBrand digits above them. */
  .cd-label {
    font-family: 'Helvetica', Arial, sans-serif;
    font-weight: 400;
    letter-spacing: 0.04em;
    color: rgba(0, 0, 0, 0.7);
  }
</style>

<script is:inline define:vars={{ targetDate }}>
  (function() {
    const target = new Date(targetDate).getTime();
    const pad = n => String(Math.max(0, n)).padStart(2, '0');

    function tick() {
      const diff = Math.max(0, target - Date.now());
      const d = pad(Math.floor(diff / 86400000));
      const h = pad(Math.floor((diff % 86400000) / 3600000));
      const m = pad(Math.floor((diff % 3600000) / 60000));
      const s = pad(Math.floor((diff % 60000) / 1000));

      document.querySelectorAll('.cd-days').forEach(el => el.textContent = d);
      document.querySelectorAll('.cd-hours').forEach(el => el.textContent = h);
      document.querySelectorAll('.cd-minutes').forEach(el => el.textContent = m);
      document.querySelectorAll('.cd-seconds').forEach(el => el.textContent = s);
    }

    tick();
    setInterval(tick, 1000);
  })();
</script>
