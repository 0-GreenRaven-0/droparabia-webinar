---
import '../styles/global.css';
import Hero from '../components/Hero.astro';
import WorkshopSection from '../components/WorkshopSection.astro';
import HostSection from '../components/HostSection.astro';
import LearnSection from '../components/LearnSection.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import RegistrationForm from '../components/RegistrationForm.astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>Droparabia — Free Live Workshop</title>
    <meta
      name="description"
      content="Join Majd Abdulsalam in a live workshop and learn how to build a profitable dropshipping business in Lebanon using Droparabia — from scratch, step by step."
    />

    <link rel="icon" type="image/png" href="/Droparabia.png" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="overflow-x-hidden" style="background: #E0E0E0;">

    <Hero />
    <WorkshopSection />
    <HostSection />
    <LearnSection />

    <Testimonials />

    <FAQ />

    <!-- Final CTA -->
    <div class="py-20 px-6 text-center" style="background: #E0E0E0;" id="register">
      <div class="max-w-2xl mx-auto flex flex-col items-center gap-5">
        <h2 style="font-family: 'IBrand', sans-serif; font-size: clamp(32px, 4vw, 52px); font-weight: 400; letter-spacing: -0.01em; color: #000; margin: 0; line-height: 1.15;">
          By the end of the workshop...
        </h2>
        <p style="font-family: 'Outfit', sans-serif; font-size: clamp(16px, 1.5vw, 22px); font-weight: 500; color: rgba(0,0,0,0.75); margin: 0; line-height: 1.55; max-width: 640px;">
          You're ready to start building your own dropshipping business and make your way towards your first $2,000 – $3,000
        </p>
        <div style="font-family: 'IBrand', sans-serif; font-size: 16px; color: rgba(0,0,0,0.55);">
          Doors close on <strong style="color: #000;">May 21, 2026</strong>
        </div>
        <a href="#register" class="cta-final" onclick="event.preventDefault(); document.getElementById('regModal').classList.add('show')">Secure Your Spot Now!</a>
        <p style="font-family: 'IBrand', sans-serif; font-size: 12px; color: rgba(0,0,0,0.5); margin: 0;">
          Replays aren't guaranteed so be sure to not miss out
        </p>
      </div>
    </div>

    <!-- Registration modal -->
    <div id="regModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.5); backdrop-filter:blur(4px); z-index:100; align-items:center; justify-content:center; padding:24px;" onclick="if(event.target===this)this.classList.remove('show')">
      <div style="background:#fff; border-radius:24px; padding:36px; max-width:480px; width:100%; position:relative; box-shadow:0 30px 80px rgba(0,0,0,0.4);">
        <button onclick="document.getElementById('regModal').classList.remove('show')" style="position:absolute; right:16px; top:16px; background:transparent; border:0; width:32px; height:32px; border-radius:50%; cursor:pointer; font-size:18px; display:flex; align-items:center; justify-content:center;">✕</button>
        <RegistrationForm id="register-form" prefix="rf1" />
      </div>
    </div>
    <style>
      #regModal.show { display: flex; }
      .cta-final {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgb(20, 173, 0);
        color: #fff;
        font-family: 'IBrand', sans-serif;
        font-size: 20px;
        letter-spacing: -0.01em;
        border-radius: 16px;
        padding: 16px 48px;
        text-decoration: none;
        box-shadow: 0 6px 0 rgb(7, 97, 12), 0 14px 28px rgba(0,0,0,0.2);
        transition: transform .12s ease, box-shadow .12s ease;
      }
      .cta-final:hover {
        transform: translateY(2px);
        box-shadow: 0 4px 0 rgb(7, 97, 12), 0 10px 22px rgba(0,0,0,0.25);
        color: #fff;
      }
      @media (max-width: 768px) {
        .cta-final { font-size: 16px; padding: 12px 28px; }
      }
    </style>

    <!-- Footer -->
    <footer style="border-top: 1px solid rgba(255,255,255,0.08); background: linear-gradient(135deg, #000c3d 0%, #001575 45%, #002199 70%, #001060 100%)">
      <div class="max-w-6xl mx-auto px-6 py-12 grid grid-cols-1 md:grid-cols-2 gap-10">
        <div class="flex flex-col gap-4">
          <div class="flex items-center gap-2">
            <img src="/Droparabia.png" alt="Droparabia" class="h-10 w-auto object-contain" />
            <span style="font-family: 'IBrand', sans-serif; font-size: 1.5rem; letter-spacing: -0.01em; color:#fff;">Droparabia</span>
          </div>
          <p class="text-sm leading-relaxed max-w-xs" style="color: rgba(255,255,255,0.6);">
            Lebanon's first dropshipping platform — built to help you launch, sell, and scale without inventory risk.
          </p>
        </div>
        <div class="flex flex-col gap-3">
          <p class="text-xs font-bold uppercase tracking-widest mb-1" style="color: rgba(255,255,255,0.5);">Quick Links</p>
          <a href="#register" class="text-sm no-underline" style="color: rgba(255,255,255,0.7);">Register for the Workshop</a>
          <a href="#learn-section" class="text-sm no-underline" style="color: rgba(255,255,255,0.7);">What You'll Learn</a>
          <a href="#faq" class="text-sm no-underline" style="color: rgba(255,255,255,0.7);">FAQ</a>
        </div>
      </div>
      <div style="border-top: 1px solid rgba(255,255,255,0.1); padding: 20px 24px; text-align: center;">
        <p class="text-xs" style="color: rgba(255,255,255,0.45);">
          © {new Date().getFullYear()} Droparabia. All rights reserved. · Lebanon's #1 Dropshipping Platform
        </p>
      </div>
    </footer>

  </body>
</html>
