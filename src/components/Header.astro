---
---

<header class="site-header">
  <a href="/" class="site-header-brand">
    <img src="/Droparabia.webp" alt="Droparabia" class="site-header-logo" />
    <span class="site-header-name">Droparabia</span>
  </a>
  <a href="#register" class="site-header-cta">Register Now</a>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 24px;
    background: #F0F0F0;
    box-shadow: 0 2px 14px rgba(0, 0, 0, 0.13);
  }

  .site-header-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }
  .site-header-logo {
    height: 42px;
    width: auto;
    object-fit: contain;
  }
  .site-header-name {
    font-family: 'IBrand', sans-serif;
    font-size: 1.6rem;
    letter-spacing: -0.01em;
    color: #000;
  }

  .site-header-cta {
    font-family: 'Helvetica', Arial, sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #fff;
    text-decoration: none;
    background: rgb(20, 173, 0);
    padding: 12px 26px;
    border-radius: 8px;
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .site-header-cta:hover {
    background: rgb(16, 150, 0);
    transform: translateY(-1px);
    color: #fff;
  }

  @media (max-width: 1023px) {
    .site-header { padding: 8px 16px; }
    .site-header-logo { height: 34px; }
    .site-header-name { font-size: 1.3rem; }
    .site-header-cta { font-size: 0.72rem; padding: 10px 16px; }
  }
</style>
