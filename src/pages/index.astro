---
// Homepage: the pasted Landing_Page.html copied element for element, using its own
// CSS (src/styles/landing.css), with Droparabia's palette, fonts and logo swapped in.
// Its form markup is untouched; only the stub submit handler ("TODO: connect to your
// CRM") is replaced below by a real POST to /api/register -> Google webinar sheet.
import '../styles/global.css';
import '../styles/landing.css';
import Analytics from '../components/Analytics.astro';
import GtmNoscript from '../components/GtmNoscript.astro';
import MetaPixel from '../components/MetaPixel.astro';
import MetaPixelNoscript from '../components/MetaPixelNoscript.astro';
import MetaEvents from '../components/MetaEvents.astro';
import { WEBINAR_START_ISO, SOCIAL_INSTAGRAM, SOCIAL_THREADS, SOCIAL_YOUTUBE } from '../config/webinar';
import { SI_INSTAGRAM, SI_THREADS, SI_YOUTUBE } from '../config/icons';
import { META_PIXEL_ID } from '../config/meta';
