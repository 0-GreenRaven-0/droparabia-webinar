---

<section class="hero-section relative" id="hero-section">
  <div class="hero-content">
    <p class="hero-badge"><span class="hero-badge-dot"></span>Free Live Workshop</p>

    <h1 class="hero-headline" id="hero-headline">Build a <span class="hero-gradient-text">successful &amp; high-earning</span> e-com business using Lebanon's most powerful system</h1>
    <script is:inline>
      // Headline A/B test — one variant is picked randomly per browser session
      // (sessionStorage, not localStorage) so it stays put across page views within
      // a visit but reshuffles on the next session.
      (function() {
        var GRADIENT = 'hero-gradient-text';
        var names = ['Mechanism', 'Pain'];
        var variants = [
          // Mechanism
          'Build a <span class="' + GRADIENT + '">successful &amp; high-earning</span> e-com business using Lebanon\'s most powerful system',
          // Pain
          'How to build a <span class="' + GRADIENT + '">successful &amp; high-earning</span> e-com business without risking your budget on traditional e-com',
        ];

        var idx = parseInt(sessionStorage.getItem('heroHeadlineVariant'), 10);
        if (isNaN(idx) || idx < 0 || idx >= variants.length) {
          idx = Math.floor(Math.random() * variants.length);
          sessionStorage.setItem('heroHeadlineVariant', String(idx));
        }

        // Re-stamped on every load (not just when the index is first picked) so the
        // registration form always has the name of the headline actually shown.
        sessionStorage.setItem('heroHeadlineName', names[idx]);

        var h1 = document.getElementById('hero-headline');
        if (h1) h1.innerHTML = variants[idx];
      })();
    </script>

    <p class="hero-subheadline"><strong>DISCLAIMER:</strong> This isn't the old dropshipping you're familiar with</p>
  </div>
</section>

<style>
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'IBrand', sans-serif;
    font-size: 16px;
    font-weight: 400;
    letter-spacing: 0.03em;
    color: #000;
    border: 1.5px solid #001eff;
    border-radius: 999px;
    padding: 7px 20px;
    margin: 0 0 22px;
    box-shadow: 0 0 0 4px rgba(0, 30, 255, 0.08);
  }
  .hero-badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: #ff4444;
    flex-shrink: 0;
  }

  @media (max-width: 1023px) {
    .hero-badge { font-size: 13px; padding: 6px 15px; margin-bottom: 16px; }
  }
</style>
