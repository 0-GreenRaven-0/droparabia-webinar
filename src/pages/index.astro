<html lang="en">
  <head>
    <Analytics />
    <MetaPixel />
    <meta charset="utf-8" />
    <title>Droparabia Free Live Training</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/Droparabia.webp" />
  </head>
  <body>
    <GtmNoscript />
    <MetaPixelNoscript />
<div style="font-family: 'Helvetica', Arial, sans-serif; color: #0D0D2B; background: #FFFFFF; min-height: 100vh">
<!-- No tint and no rule: the header sits on the same surface as the page. -->
<div class="da-top" style="max-width: 1240px; margin: 0 auto; padding: 18px 24px; box-sizing: border-box; display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap">
<div style="display: flex; align-items: center; gap: 10px">
<img class="da-logo" src="/Droparabia.webp" alt="" style="width: 40px; height: 40px; object-fit: contain; display: block">
<div class="da-brand" style="font-family: 'IBrand', sans-serif; font-weight: 800; font-size: 22px; letter-spacing: -0.02em; color: #0D0D2B">Droparabia</div>
</div>
<div style="background: #001EFF; color: #FFFFFF; font-weight: 700; font-size: 13px; letter-spacing: 0.08em; padding: 9px 16px; border-radius: 999px" class="da-pill">FREE LIVE TRAINING</div>
</div>

<div class="da-wrap" style="max-width: 1240px; margin: 0 auto; padding: 40px 24px 0; box-sizing: border-box">
