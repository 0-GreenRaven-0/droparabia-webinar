---
const faqs = [
  {
    q: 'When and how can I attend this workshop?',
    a: 'The workshop is happening on Monday, July 13th at 6:30 PM on Zoom. Register your spot now and we will send you everything you need, including the link and instructions, directly to your email.',
  },
  {
    q: "Will there be a replay in case I couldn't attend the workshop?",
    a: "We recommend that you do your best to attend this workshop because we cannot guarantee any replays in case you miss out.",
  },
  {
    q: 'Who is this workshop for?',
    a: "This is for every Lebanese who wants to start their own profitable online store but is looking for better support or a proven system rather than courses or mentorships that only do the teaching part.",
  },
  {
    q: "I don't have any marketing experience whatsoever. Would I be able to understand what I'll learn in this workshop?",
    a: "Absolutely! Majd Abdulsalam already took that into account and made sure to break everything down so that even a first grader can understand, regardless of whether they are a strong English speaker or not.",
  },
  {
    q: "I keep hearing on social media that now is absolutely not the right time to start ecommerce with everything that is going on in Lebanon",
    a: "Despite everything that is going on right now, the market is still moving and people are still buying. Once all that stops, then not just this model you are about to learn, but trading in general will come to a halt.",
  },
  {
    q: 'Why start an online store when I can start freelancing or build an agency?',
    a: "It is absolutely important that you learn new skills and add more knowledge to your arsenal, but here is what those coaches and consultants on social media do not tell you. You might spend 2 years learning a skill and only start making money after a few more years, and that is only if that skill was the right fit for you in the first place.",
  },
];
---

<section class="section-alt">
  <div class="section">

    <div class="text-center mb-12 gs-faq-header">
      <h2 class="text-4xl sm:text-5xl font-extrabold">
        Frequently Asked <span class="gradient-text">Questions</span>
      </h2>
    </div>

    <div class="flex flex-col gap-4 max-w-2xl mx-auto gs-faq-list">
      {faqs.map((faq, i) => (
        <div class="faq-card" id={`faq-card-${i}`}>
          <button class="faq-btn w-full flex items-start justify-between gap-4 text-left" data-faq={i} aria-expanded="false">
            <span class="font-medium text-text-base text-base leading-snug pt-0.5">{faq.q}</span>
            <svg class="faq-icon shrink-0 text-primary mt-0.5" width="20" height="20" viewBox="0 0 20 20" fill="none">
              <path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div class="faq-answer" id={`faq-answer-${i}`}>
            <p class="text-text-base text-base leading-relaxed pt-3">{faq.a}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .faq-card {
    background: #fff;
    border: 2px solid rgba(0,0,0,0.1);
    border-radius: 1rem;
    padding: 1.25rem 1.5rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
    transition: border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
    cursor: pointer;
  }
  .faq-card:hover {
    border-color: rgba(43, 159, 217, 0.5);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.45), 0 0 0 4px rgba(43, 159, 217, 0.08);
  }
  .faq-card.open {
    border-color: rgba(43, 159, 217, 0.65);
    background: rgba(43, 159, 217, 0.07);
    box-shadow: 0 6px 28px rgba(0, 0, 0, 0.5), 0 0 0 4px rgba(43, 159, 217, 0.1);
  }
  .faq-answer {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease;
    overflow: hidden;
  }
  .faq-answer.open {
    grid-template-rows: 1fr;
  }
  .faq-answer > p {
    overflow: hidden;
  }
  .faq-icon {
    transition: transform 0.3s ease;
  }
  .faq-icon.open {
    transform: rotate(180deg);
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.faq-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const idx = btn.dataset.faq!;
      const answer = document.getElementById(`faq-answer-${idx}`)!;
      const card = document.getElementById(`faq-card-${idx}`)!;
      const icon = btn.querySelector('.faq-icon')!;
      const isOpen = card.classList.contains('open');

      document.querySelectorAll('.faq-answer').forEach((a) => a.classList.remove('open'));
      document.querySelectorAll('.faq-card').forEach((c) => c.classList.remove('open'));
      document.querySelectorAll('.faq-icon').forEach((ic) => ic.classList.remove('open'));
      document.querySelectorAll('.faq-btn').forEach((b) => b.setAttribute('aria-expanded', 'false'));

      if (!isOpen) {
        answer.classList.add('open');
        card.classList.add('open');
        icon.classList.add('open');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
