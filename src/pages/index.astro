<script is:inline>
  // Campaign tags, captured the moment the visit lands.
  //
  // This has to run on page load, not at submit: the parameters only exist on the
  // URL the visit arrived on, and the referrer only on its first page. Reading
  // them at submit meant anyone who opened the Terms, pressed Back, or reloaded
  // without the query string registered as if they had come from nowhere — real
  // ad clicks recorded as untraceable visits.
  //
  // First value wins, so a later page view cannot overwrite a known source with
  // a blank one.
  (function () {
    try {
      var p = new URLSearchParams(window.location.search);
      var fields = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
      for (var i = 0; i < fields.length; i++) {
        var v = p.get(fields[i]);
        if (v && !sessionStorage.getItem('da_' + fields[i])) sessionStorage.setItem('da_' + fields[i], v);
      }
      if (document.referrer && !sessionStorage.getItem('da_referrer')) {
        sessionStorage.setItem('da_referrer', document.referrer);
      }
    } catch (_) {
      // Private mode or blocked storage: the submit handler still reads the URL.
    }
  })();
</script>

<script is:inline define:vars={{ EVENT_DATE: WEBINAR_START_ISO }}>
  (function () {
    var t = new Date(EVENT_DATE).getTime();
    function p(n) { return String(n).padStart(2, '0'); }
    function tick() {
      var x = Math.max(0, Math.floor((t - Date.now()) / 1000));
      var d = Math.floor(x / 86400); x -= d * 86400;
      var h = Math.floor(x / 3600);  x -= h * 3600;
      var m = Math.floor(x / 60);
      document.getElementById('cd-d').textContent = p(d);
      document.getElementById('cd-h').textContent = p(h);
      document.getElementById('cd-m').textContent = p(m);
      document.getElementById('cd-s').textContent = p(x - m * 60);
    }
    tick(); setInterval(tick, 1000);
  })();
</script>

