<section class="final-cta-section">
  <h2 class="final-cta-heading">So, you want the hard way or the smart and efficient way?</h2>
  <p class="final-cta-sub">You'll never consider going back to the traditional e-commerce after you discover this new powerful system</p>
  <a href="#register" class="final-cta-btn">
    <span>Reserve your seat now!</span>
    <span>Before they're all taken</span>
  </a>
</section>

<style>
  .final-cta-section {
    background: #F0F0F0;
    padding: 72px 24px;
    text-align: center;
  }
  .final-cta-heading {
    font-family: 'IBrand', sans-serif;
    font-weight: 400;
    font-size: clamp(28px, 5vw, 48px);
    letter-spacing: -0.01em;
    color: #000;
    max-width: 780px;
    margin: 0 auto 16px;
    line-height: 1.2;
  }
  .final-cta-sub {
    font-family: 'Helvetica', Arial, sans-serif;
    font-size: clamp(15px, 2vw, 19px);
    color: rgba(0,0,0,0.7);
    max-width: 620px;
    margin: 0 auto 36px;
    line-height: 1.5;
  }
  .final-cta-btn {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    padding: 18px 48px;
    border-radius: 12px;
    color: #fff;
    text-decoration: none;
    background: rgb(20, 173, 0);
    box-shadow: 0 12px 32px -10px rgba(20, 173, 0, 0.45);
    transition: transform 0.15s ease, background 0.15s ease;
  }
  .final-cta-btn:hover {
    transform: translateY(-2px);
    background: rgb(16, 150, 0);
  }
  .final-cta-btn span:first-child {
    font-family: 'Helvetica', Arial, sans-serif;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .final-cta-btn span:last-child {
    font-family: 'Helvetica', Arial, sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    opacity: 0.9;
  }

  @media (max-width: 1023px) {
    .final-cta-section { padding: 56px 20px; }
  }
</style>
