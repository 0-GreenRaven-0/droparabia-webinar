---
import 'swiper/css';
---

<section class="testo-section" id="testimonials">
  <div class="section pt-4 sm:pt-10" style="padding-bottom: 40px;">

    <!-- Header -->
    <div class="text-center mb-6 gs-test-header">
      <h2 class="testo-heading text-sm lg:text-2xl font-semibold mb-4 text-black max-w-3xl mx-auto leading-snug">
        <span class="text-[#001eff]">Over 800 Lebanese</span> are currently using this new system to sell all over Lebanon
      </h2>
    </div>


    <!-- Swiper Carousel -->
    <div class="carousel-container">
      <button class="swiper-button-prev" aria-label="Previous">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
      </button>
      <button class="swiper-button-next" aria-label="Next">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
      </button>
      <div class="swiper testimonials-swiper">
        <div class="swiper-wrapper">
          {[
            // Newest testimonials first, ahead of the older case-study screenshots —
            // matches droparabia-official's CaseStudyCarousels.astro.
            "https://ik.imagekit.io/greenraven/droparabia/testimonial-1.png?tr=w-900,q-70,f-webp",
            "https://ik.imagekit.io/greenraven/droparabia/testimonial-2.png?tr=w-900,q-70,f-webp",
            "https://ik.imagekit.io/greenraven/droparabia/testimonial-3.png?tr=w-900,q-70,f-webp",
            "https://ik.imagekit.io/greenraven/droparabia/testimonial-4.png?tr=w-900,q-70,f-webp",
            "https://ik.imagekit.io/greenraven/MJ/Case%20Studies/4.png?tr=w-900,q-70,f-webp",
            "https://ik.imagekit.io/greenraven/MJ/Case%20Studies/5.png?tr=w-900,q-70,f-webp",
            "https://ik.imagekit.io/greenraven/MJ/Case%20Studies/2.png?tr=w-900,q-70,f-webp",
            "https://ik.imagekit.io/greenraven/MJ/Case%20Studies/6.png?tr=w-900,q-70,f-webp",
            "https://ik.imagekit.io/greenraven/MJ/Case%20Studies/1.png?tr=w-900,q-70,f-webp",
            "https://ik.imagekit.io/greenraven/MJ/Case%20Studies/2.png?tr=w-900,q-70,f-webp",
            "https://ik.imagekit.io/greenraven/MJ/Case%20Studies/3.png?tr=w-900,q-70,f-webp",
            "https://ik.imagekit.io/greenraven/MJ/Testimonials/Testo.png?tr=w-900,q-70,f-webp",
            "https://ik.imagekit.io/greenraven/MJ/Testimonials/Testo%20(1).png?tr=w-900,q-70,f-webp",
          ].map((src) => (
            <div class="swiper-slide">
              <img src={src} alt="Testimonial" loading="lazy" />
            </div>
          ))}
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  /* Wider than the shared .section cap so the slides get more room. */
  .section {
    max-width: 1400px;
    padding-top: 46px;
  }

  .carousel-container {
    max-width: 1340px;
    margin: 0 auto;
    padding: 0 70px;
    position: relative;
  }

  /* Swiper's track is overflow:hidden, so without padding on every side the slide
     shadows get sliced off flat against the container edge. The padding sits inside
     the clip box, giving the halo room to render on all four sides.
     The mask then fades those same edges out, so the slide scrolling in from
     off-track — and its shadow — dissolves instead of hitting a hard vertical seam. */
  .testimonials-swiper {
    padding: 22px 24px 30px;
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 24px, #000 calc(100% - 24px), transparent 100%);
    mask-image: linear-gradient(to right, transparent 0, #000 24px, #000 calc(100% - 24px), transparent 100%);
  }

  .testimonials-swiper .swiper-slide {
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 0 22px rgba(0, 0, 0, 0.18), 0 12px 26px -6px rgba(0, 0, 0, 0.26);
  }

  .testimonials-swiper .swiper-slide img {
    width: 100%;
    height: auto;
    display: block;
  }

  .carousel-container .swiper-button-prev,
  .carousel-container .swiper-button-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 56px;
    height: 56px;
    background: linear-gradient(135deg, #4B0FC4, #001EFF 45%, #000c66);
    color: #fff;
    border-radius: 50%;
    border: none;
    outline: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    transition: background 0.2s, color 0.2s;
  }

  .carousel-container .swiper-button-prev { left: 4px; }
  .carousel-container .swiper-button-next { right: 4px; }

  .carousel-container .swiper-button-prev::after,
  .carousel-container .swiper-button-next::after {
    display: none;
  }

  .carousel-container .swiper-button-prev svg,
  .carousel-container .swiper-button-next svg {
    width: 26px;
    height: 26px;
    display: block;
  }

  .carousel-container .swiper-button-prev:hover,
  .carousel-container .swiper-button-next:hover {
    background: linear-gradient(135deg, #4B0FC4, #001EFF 45%, #000c66);
    color: #fff;
  }

  /* Overrides the global h1–h6 IBrand rule. */
  .testo-heading {
    font-family: 'Helvetica', Arial, sans-serif;
  }

  .testo-section {
    background: #F0F0F0;
  }

  @media (max-width: 1023px) {
    .section {
      padding-left: 8px;
      padding-right: 8px;
    }
    .carousel-container {
      padding: 0 6px;
    }
    /* Stays under the 22px slide gap so neighbours don't peek into the padding. */
    .testimonials-swiper {
      padding: 16px 14px 24px;
      -webkit-mask-image: linear-gradient(to right, transparent 0, #000 14px, #000 calc(100% - 14px), transparent 100%);
      mask-image: linear-gradient(to right, transparent 0, #000 14px, #000 calc(100% - 14px), transparent 100%);
    }
    .carousel-container .swiper-button-prev,
    .carousel-container .swiper-button-next {
      width: 36px;
      height: 36px;
    }
    .carousel-container .swiper-button-prev svg,
    .carousel-container .swiper-button-next svg {
      width: 20px;
      height: 20px;
    }
  }
</style>

<script>
  async function initSwipers() {
    const [{ default: Swiper }, { Navigation }] = await Promise.all([
      import('swiper'),
      import('swiper/modules'),
    ]);

    document.querySelectorAll('.testimonials-swiper').forEach((swiperEl) => {
      const container = swiperEl.closest('.carousel-container');
      if (!container) return;
      new Swiper(swiperEl as HTMLElement, {
        modules: [Navigation],
        slidesPerView: 1,
        // Each gap must stay wider than .testimonials-swiper's horizontal padding,
        // otherwise the neighbouring slide pokes into that padding and shows as a
        // sliver at the edge of the track.
        spaceBetween: 22,
        breakpoints: {
          600: { slidesPerView: 2, spaceBetween: 28 },
          1024: { slidesPerView: 3, spaceBetween: 34 },
        },
        loop: true,
        navigation: {
          nextEl: container.querySelector('.swiper-button-next') as HTMLElement,
          prevEl: container.querySelector('.swiper-button-prev') as HTMLElement,
        },
        pagination: false,
      });
    });
  }

  const swiperEls = document.querySelectorAll('.testimonials-swiper');
  if (swiperEls.length && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries, obs) => {
      if (entries.some((entry) => entry.isIntersecting)) {
        obs.disconnect();
        initSwipers();
      }
    }, { rootMargin: '200px' });
    swiperEls.forEach((el) => observer.observe(el));
  } else {
    initSwipers();
  }
</script>
