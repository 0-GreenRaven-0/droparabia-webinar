<!-- Desktop layout -->
<section class="host-desktop" id="host-section">
  <div class="host-left">
    <div class="eyebrow">Meet</div>
    <h2><span class="name-white">Majd </span><span class="name-cyan">Abdulsalam</span></h2>
    <p>A dropshipping and digital marketing expert who made 6-figures over the past few years. Helped over 600 Lebanese start their own online business with success and founded Droparabia, Lebanon's 1st dropshipping platform that will forever reshape how online selling in Lebanon and soon in the MENA regions is done.</p>
    <p>And now Majd is going to teach you live everything you need from A to Z in order to start your own profitable online store and answer whatever questions you have!</p>
  </div>
  <div class="host-photo-wrap">
    <div class="host-photo">
      <img src="/mj.jpeg" alt="Majd Abdulsalam" />
    </div>
    <div class="host-pills">
      <div class="pill purple">Made over<br>6-Figures</div>
      <div class="pill blue">Founder of<br>Droparabia</div>
      <div class="pill black">+5 years<br>Digital Marketing<br>experience</div>
    </div>
  </div>
</section>

<!-- Mobile layout -->
<section class="host-mobile" id="host-section-mobile">
  <div class="eyebrow">Meet</div>
  <h2><span class="name-white">Majd </span><span class="name-cyan">Abdulsalam</span></h2>

  <div class="host-photo-wrap">
    <div class="host-photo">
      <img src="/mj.jpeg" alt="Majd Abdulsalam" />
    </div>
    <div class="host-pills">
      <div class="pill purple">Made over<br>6-Figures</div>
      <div class="pill blue">Founder of<br>Droparabia</div>
      <div class="pill black">+5 years<br>Digital Marketing<br>experience</div>
    </div>
  </div>

  <div class="host-text-mobile">
    <p>A dropshipping and digital marketing expert who made 6-figures over the past few years. Helped over 600 Lebanese start their own online business with success and founded Droparabia, Lebanon's 1st dropshipping platform that will forever reshape how online selling in Lebanon and soon in the MENA regions is done.</p>
    <p>And now Majd is going to teach you live everything you need from A to Z in order to start your own profitable online store and answer whatever questions you have!</p>
  </div>
</section>

<style>
  /* ─── Shared ────────────────────────────────────────── */
