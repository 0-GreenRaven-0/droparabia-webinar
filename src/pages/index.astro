---
import '../styles/global.css';
import Hero from '../components/Hero.astro';
import WorkshopSection from '../components/WorkshopSection.astro';
import HostSection from '../components/HostSection.astro';
import LearnSection from '../components/LearnSection.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';

---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>Droparabia — Free Live Workshop</title>
    <meta
      name="description"
      content="Join Majd Abdulsalam in a live workshop and learn how to build a profitable dropshipping business in Lebanon using Droparabia — from scratch, step by step."
    />

    <link rel="icon" type="image/png" href="/Droparabia.png" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="overflow-x-hidden" style="background: #F0F0F0;">

    <Hero />
    <Testimonials />
    <WorkshopSection />
    <HostSection />
    <LearnSection />

    <FAQ />

    <!-- Registration Form -->
    <section id="register" class="py-20 px-6" style="background: #F0F0F0;">
      <div class="max-w-md mx-auto">
        <h2 class="text-3xl sm:text-4xl font-normal text-black text-center mb-8" style="font-family: 'IBrand', sans-serif;">
          Secure your spot now!
        </h2>
        <form id="webinar-form" class="flex flex-col gap-4">
          <div class="flex gap-4">
            <div class="flex-1">
              <label class="block text-sm text-black/60 mb-1" style="font-family: 'Outfit', sans-serif;">First Name</label>
              <input type="text" name="firstName" required placeholder="First name" class="w-full rounded-xl px-4 py-3 bg-white border border-gray-400 text-black placeholder:text-black/30 focus:outline-none focus:border-gray-400" style="font-family: 'Outfit', sans-serif;" />
            </div>
            <div class="flex-1">
              <label class="block text-sm text-black/60 mb-1" style="font-family: 'Outfit', sans-serif;">Last Name</label>
              <input type="text" name="lastName" placeholder="Last name" class="w-full rounded-xl px-4 py-3 bg-white border border-gray-400 text-black placeholder:text-black/30 focus:outline-none focus:border-gray-400" style="font-family: 'Outfit', sans-serif;" />
            </div>
          </div>
          <div>
            <label class="block text-sm text-black/60 mb-1" style="font-family: 'Outfit', sans-serif;">Phone Number</label>
            <div class="flex items-center gap-2 rounded-xl px-4 py-3 bg-white border border-gray-400">
              <span class="text-black/40 text-sm shrink-0">+961</span>
              <input type="tel" name="phone" required placeholder="XX XXX XXX" maxlength="10" class="flex-1 bg-transparent text-black placeholder:text-black/30 focus:outline-none" style="font-family: 'Outfit', sans-serif;" />
            </div>
          </div>
          <div>
            <label class="block text-sm text-black/60 mb-1" style="font-family: 'Outfit', sans-serif;">Email</label>
            <input type="email" name="email" required placeholder="your@email.com" class="w-full rounded-xl px-4 py-3 bg-white border border-gray-400 text-black placeholder:text-black/30 focus:outline-none focus:border-gray-400" style="font-family: 'Outfit', sans-serif;" />
          </div>
          <button type="submit" class="mt-2 w-full rounded-2xl px-8 py-4 text-white text-lg cursor-pointer border-none" style="font-family: 'IBrand', sans-serif; background: rgb(20, 173, 0); box-shadow: 0 6px 0 rgb(7, 97, 12), 0 14px 28px rgba(0,0,0,0.2); transition: transform 0.12s ease, box-shadow 0.12s ease;">
            Register Now!
          </button>
          <p id="form-msg" class="text-center text-sm hidden" style="font-family: 'Outfit', sans-serif;"></p>
        </form>
      </div>
    </section>

    <script is:inline>
      document.getElementById('webinar-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const form = e.target;
        const btn = form.querySelector('button[type="submit"]');
        const msg = document.getElementById('form-msg');
        const data = {
          firstName: form.firstName.value.trim(),
          lastName: form.lastName.value.trim(),
          phone: '+961' + form.phone.value.replace(/\D/g, ''),
          email: form.email.value.trim(),
        };
        btn.disabled = true;
        btn.textContent = 'Submitting...';
        msg.classList.add('hidden');
        try {
          const res = await fetch('/api/register', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data),
          });
          const result = await res.json();
          if (result.success) {
            msg.textContent = 'You\'re registered! See you at the workshop.';
            msg.classList.remove('hidden');
            msg.style.color = '#16a34a';
            form.reset();
          } else {
            msg.textContent = result.error || 'Something went wrong. Try again.';
            msg.classList.remove('hidden');
            msg.style.color = '#dc2626';
          }
        } catch {
          msg.textContent = 'Network error. Please try again.';
          msg.classList.remove('hidden');
          msg.style.color = '#dc2626';
        }
        btn.disabled = false;
        btn.textContent = 'Register Now!';
      });
    </script>

    <!-- Footer -->
    <footer style="border-top: 1px solid rgba(255,255,255,0.08); background: linear-gradient(135deg, #000c3d 0%, #001575 45%, #002199 70%, #001060 100%)">
      <div class="max-w-6xl mx-auto px-6 py-12 grid grid-cols-1 md:grid-cols-2 gap-10">
        <div class="flex flex-col gap-4">
          <div class="flex items-center gap-2">
            <img src="/Droparabia.png" alt="Droparabia" class="h-10 w-auto object-contain" />
            <span style="font-family: 'IBrand', sans-serif; font-size: 1.5rem; letter-spacing: -0.01em; color:#fff;">Droparabia</span>
          </div>
          <p class="text-sm leading-relaxed max-w-xs" style="color: rgba(255,255,255,0.6);">
            Lebanon's first dropshipping platform — built to help you launch, sell, and scale without inventory risk.
          </p>
        </div>
        <div class="flex flex-col gap-3">
          <p class="text-xs font-bold uppercase tracking-widest mb-1" style="color: rgba(255,255,255,0.5);">Quick Links</p>
          <a href="#register" class="text-sm no-underline" style="color: rgba(255,255,255,0.7);">Register for the Workshop</a>
          <a href="#learn-section" class="text-sm no-underline" style="color: rgba(255,255,255,0.7);">What You'll Learn</a>
          <a href="#faq" class="text-sm no-underline" style="color: rgba(255,255,255,0.7);">FAQ</a>
        </div>
      </div>
      <div style="border-top: 1px solid rgba(255,255,255,0.1); padding: 20px 24px; text-align: center;">
        <p class="text-xs" style="color: rgba(255,255,255,0.45);">
          © {new Date().getFullYear()} Droparabia. All rights reserved. · Lebanon's #1 Dropshipping Platform
        </p>
      </div>
    </footer>

  </body>
</html>
