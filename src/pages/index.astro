<div style="background: #EEF1FF; border: 1px solid #DDE3F5; border-radius: 14px; padding: 18px"><div style="font-family: 'IBrand', sans-serif; font-size: 28px; font-weight: 800; color: #001EFF">Shopify</div><div style="font-size: 14px; color: #44506A; margin-top: 4px">official partner</div></div>
