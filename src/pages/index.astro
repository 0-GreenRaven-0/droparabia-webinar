<script is:inline>
  // VSL: starts on its own but silent, which is the only autoplay browsers allow.
  // A "Tap for sound" badge sits on it the whole time it plays muted; one tap
  // anywhere on the frame turns the sound on and hands over to the native controls.
  (function () {
    var v = document.getElementById('vsl');
    if (!v) return;
    var frame = v.parentElement;
    var badge = frame.querySelector('.vsl-sound');
    var play = frame.querySelector('.vsl-play');

    function unmute() {
      if (!v.muted) return;
      v.muted = false;
      v.volume = 1;
      v.controls = true;
      var p = v.play();
      if (p && p.catch) p.catch(function () {});
      if (badge) badge.classList.add('is-gone');
      if (play) play.classList.add('is-gone');
    }


    // Watch time, in seconds, for the sheet row. Accumulated from timeupdate
    // deltas rather than read off currentTime, so scrubbing forward cannot
    // inflate it and a pause does not keep counting. Deltas over a second are
    // treated as a seek and skipped.
    var daWatched = 0;
    var daLastTime = null;
    v.addEventListener('timeupdate', function () {
      var now = v.currentTime;
      if (daLastTime !== null) {
        var step = now - daLastTime;
        if (step > 0 && step < 1) daWatched += step;
      }
      daLastTime = now;
      try { sessionStorage.setItem('da_vsl_seconds', String(Math.round(daWatched))); } catch (_) {}
    });

    // The whole frame is the tap target, not just the badge.
    frame.addEventListener('click', unmute);

    // Autoplay can still be refused (iOS Low Power Mode, data-saver modes). The
    // play button is the fallback so the frame never sits there looking dead; it
    // stays hidden whenever autoplay does work.
    var started = v.play();
    if (started && started.catch) {
      started.catch(function () {
        if (play) play.classList.remove('is-gone');
        if (badge) badge.classList.add('is-gone');
      });
    }
  })();
</script>


<script is:inline define:vars={{ PIXEL_ID: META_PIXEL_ID }}>
  // The mock-up's form, wired to the Google webinar sheet.
  (function () {
    var form = document.getElementById('da-form');
    if (!form) return;
    var btn = form.querySelector('button[type="submit"]');

    form.addEventListener('submit', function (e) {
      e.preventDefault();

      // Expected national-number lengths. Only the common cases are listed; anything
      // not here falls back to a permissive 6-15 digit check rather than rejecting a
      // valid number from a country we did not enumerate.
      var DIGITS = {
        // Lebanon takes two: an 03 number is 7 digits once the trunk zero is off,
        // every other mobile prefix (70/71/76/78/79/81) is 8. A single number is
        // still fine for the rest.
        '+961': [7, 8], '+971': 9, '+966': 9, '+1': 10, '+44': 10, '+33': 9, '+49': 10,
        '+20': 10, '+90': 10, '+962': 9, '+963': 9, '+964': 10, '+965': 8, '+968': 8,
        '+970': 9, '+973': 8, '+974': 8, '+212': 9, '+213': 9, '+216': 8, '+218': 9,
        '+234': 10, '+254': 9, '+91': 10, '+92': 10, '+86': 11, '+7': 10, '+55': 11,
        '+39': 10, '+34': 9, '+31': 9, '+32': 9, '+46': 9, '+61': 9, '+1264': 10,
      };

      var cc = document.getElementById('da-cc').value || '+961';
      var digits = document.getElementById('da-ph').value.replace(/\D/g, '');
      // Country code first, trunk zero second. Done the other way round, a pasted
      // "+961 03 751 043" keeps its zero — the 961 is stripped afterwards and the
      // leftover 03751043 is eight digits, so it passes and stores +96103751043.
      // Tolerate the country code being typed into the number field as well.
      var bare = cc.replace('+', '');
      if (digits.indexOf('00') === 0) digits = digits.slice(2);
      if (digits.indexOf(bare) === 0 && digits.length > bare.length) digits = digits.slice(bare.length);
      if (digits.charAt(0) === '0') digits = digits.slice(1);

      var phoneError = null;
      if (cc === '+961') {
        // Mirrors validateLebanese() in src/lib/phone.ts, which is the real gate
        // in /api/register. Kept here as plain inline code because these scripts
        // are is:inline and cannot import — and because shipping libphonenumber
        // to every visitor would cost more than this table is worth. Lebanon is
        // the one country we can state exactly: prefix decides the length, and a
        // landline is refused outright since it cannot receive the WhatsApp
        // confirmation the form promises.
        var LB = { '70': 8, '71': 8, '76': 8, '78': 8, '79': 8, '81': 8, '3': 7 };
        var order = ['70', '71', '76', '78', '79', '81', '3'];
        var good = false;
        for (var li = 0; li < order.length; li++) {
          if (digits.indexOf(order[li]) === 0 && digits.length === LB[order[li]]) { good = true; break; }
        }
        // One message, never naming a prefix: a wrong number's apparent prefix
        // misleads. 33979789 looks like a 3 number, an 07 landline looks like 71.
        if (!good) {
          phoneError = 'Please enter a valid Lebanese mobile number — 03, 70, 71, 76, 78, 79 or 81 ' +
            'followed by 6 digits. You entered ' + digits.length + ' digits.';
        }
      } else {
        var expected = DIGITS[cc];
        var lengths = expected == null ? null : (Array.isArray(expected) ? expected : [expected]);
        var ok = lengths
          ? lengths.indexOf(digits.length) !== -1
          : (digits.length >= 6 && digits.length <= 15);
        if (!ok) phoneError = 'Please enter a valid phone number for ' + cc + '.';
      }
      if (phoneError) {
        document.getElementById('da-ph').focus();
        alert(phoneError);
        return;
      }

      var params = new URLSearchParams(window.location.search);

      /**
       * The campaign tag for this visit: whatever the URL carries now, otherwise
       * whatever the first page of this visit carried. The first value wins and is
       * kept, so a later page view cannot overwrite a real source with a blank.
       * document.referrer is stored the same way, since it also only exists on the
       * page the visit landed on.
       */
      function daAttr(name) {
        var live = name === 'referrer' ? (document.referrer || '') : (params.get(name) || '');
        try {
          var saved = sessionStorage.getItem('da_' + name);
          if (live && !saved) { sessionStorage.setItem('da_' + name, live); return live; }
          return live || saved || '';
        } catch (_) {
          // Private mode and blocked storage both throw; the live value still works.
          return live;
        }
      }

      // ── What the Conversions API needs, gathered browser-side ──
      // _fbp and _fbc are set by the pixel itself and are NOT hashed: Meta matches
      // them verbatim. _fbc only exists once someone has arrived on an ad click, so
      // it is rebuilt from the fbclid parameter when the cookie has not been written
      // yet (the pixel writes it asynchronously and the form can beat it).
      // Split rather than a regex: the escapes in a regex built from a string
      // are easy to lose, and losing them here silently returns an empty _fbp
      // while _fbc still works, which is almost impossible to spot by reading.
      function daCookie(name) {
        var parts = document.cookie.split(';');
        for (var i = 0; i < parts.length; i++) {
          var p = parts[i].trim();
          if (p.indexOf(name + '=') === 0) return p.slice(name.length + 1);
        }
        return '';
      }
      var fbp = daCookie('_fbp');
      var fbc = daCookie('_fbc');
      if (!fbc) {
        var fbclid = params.get('fbclid');
        if (fbclid) fbc = 'fb.1.' + Date.now() + '.' + fbclid;
      }

      // Minted before the POST so the same id reaches both the sheet and the
      // browser's Registered event: that is what lets a server-side copy of the
      // event de-duplicate instead of counting twice.
      function daNewId(prefix) {
        return (window.crypto && window.crypto.randomUUID)
          ? window.crypto.randomUUID()
          : prefix + '-' + Date.now() + '-' + Math.random().toString(36).slice(2);
      }
      // One id per event. A Conversions API upload has to replay the exact id the
      // browser used for that event name, so Registered and Lead cannot share one
      // if both are to de-duplicate independently.
      var regEventId = daNewId('reg');
      var leadEventId = daNewId('lead');
      // Minted when VSLView fired on this page, if it did; it travels with the
      // registration so the sheet row carries all three ids.
      var vslEventId = '';
      try { vslEventId = localStorage.getItem('da_vslview_landing_id') || ''; } catch (_) {}
      // Minted here so it can travel with the request, but NOT stored yet: the
      // stored id is what makes /confirm fire Registered, so persisting it before
      // the API has confirmed the row would leave a failed attempt able to fire
      // the event if that visitor ever reached /confirm.

      var vslSeconds = 0;
      try { vslSeconds = parseInt(sessionStorage.getItem('da_vsl_seconds') || '0', 10) || 0; } catch (_) {}

      var payload = {
        firstName: document.getElementById('da-fn').value.trim().replace(/\s+/g, ' '),
        lastName: document.getElementById('da-ln').value.trim().replace(/\s+/g, ' '),
        email: document.getElementById('da-em').value.trim(),
        phone: cc + digits,
        // Remembered from the landing URL, not just read off the current one.
        // Reading only the live query string meant any second page view threw the
        // attribution away: open the Terms and come back, hit Back from anywhere,
        // reload without the parameters, and a paid click arrived looking like it
        // came from nowhere. That is what the untagged rows mostly were.
        utm_source: daAttr('utm_source'),
        utm_medium: daAttr('utm_medium'),
        utm_campaign: daAttr('utm_campaign'),
        utm_content: daAttr('utm_content'),
        utm_term: daAttr('utm_term'),
        referrer: daAttr('referrer'),
        vslSeconds: vslSeconds,
        eventId: regEventId,
        leadEventId: leadEventId,
        vslEventId: vslEventId,
        fbp: fbp,
        fbc: fbc,
        sourceUrl: window.location.href,
      };

      btn.disabled = true;
      var label = btn.textContent;
      btn.textContent = 'Saving your seat...';

      fetch('/api/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      })
        .then(function (r) { return r.json(); })
        .then(function (res) {
          if (!res.success) throw new Error(res.error || 'failed');

          // GA4 custom event: a seat was actually saved to the sheet.
          // Fired only on success, so failed attempts aren't counted.
          // No name, email or phone is sent — GA forbids PII.
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({
            event: 'lead-registered',
            webinar_date: '2026-10-29',
            traffic_source: payload.utm_source || 'direct',
            campaign: payload.utm_campaign || '',
          });

          if (typeof window.gtag === 'function') {
            window.gtag('event', 'lead-registered', {
              webinar_date: '2026-10-29',
              traffic_source: payload.utm_source || 'direct',
              campaign: payload.utm_campaign || '',
            });
          }

          // ── Meta Pixel advanced matching ──
          // Normalised, NOT hashed: the pixel applies SHA-256 itself, so hashing
          // here would double-hash and match nobody. Copied from droparabia-landing:
          // email trimmed and lowercased, phone as digits only with the country code
          // and no plus or leading zero, names lowercased.
          // Stored so every later page (and /confirm) re-inits the pixel with it.
          try {
            var em = (payload.email || '').trim().toLowerCase();
            var ph = (payload.phone || '').replace(/\D/g, '');
            var fn = (payload.firstName || '').trim().toLowerCase().replace(/\s+/g, ' ');
            var ln = (payload.lastName || '').trim().toLowerCase().replace(/\s+/g, ' ');
            localStorage.setItem('da_match', JSON.stringify({ em: em, ph: ph, fn: fn, ln: ln }));

            // The Registered event itself fires on /confirm, not here: this page
            // navigates away ~250ms from now, which is not enough for the beacon to
            // reliably leave. Storing the id is what licenses that fire, so it
            // happens only on this success path — the same id already went to the
            // sheet with the request, so the row and the browser event share one.
            sessionStorage.setItem('da_reg_event_id', regEventId);
            sessionStorage.setItem('da_lead_event_id', leadEventId);

            // Re-init straight away so anything else on this page is matched too.
            if (typeof window.fbq === 'function') {
              var match = {};
              if (em) match.em = em;
              if (ph) match.ph = ph;
              if (fn) match.fn = fn;
              if (ln) match.ln = ln;
              if (PIXEL_ID) window.fbq('init', PIXEL_ID, match);
            }
          } catch (_) {}
          var name = [payload.firstName, payload.lastName].filter(Boolean).join(' ');
          // Give the tag a moment to fire before the page unloads.
          setTimeout(function () {
            window.location.href = '/confirm?name=' + encodeURIComponent(name);
          }, 250);
        })
        .catch(function () {
          btn.disabled = false;
          btn.textContent = label;
          alert('Something went wrong. Please try again.');
        });
    });
  })();
</script>
