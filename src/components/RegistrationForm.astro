---
// Registration form embedded directly in the Hero (replaces the old CTA-button-that-scrolls-down
// pattern) — reused nowhere else, so ids below don't need to be instance-scoped.
import FlipClock from './FlipClock.astro';

interface Props {
  targetDate: string;
}
const { targetDate } = Astro.props;
---

<div id="register" class="reg-form-wrap">
  <form id="webinar-form" class="reg-form">
    <div class="reg-countdown">
      <FlipClock targetDate={targetDate} />
      <p class="reg-spots"><span class="spots-count">287</span> spots remaining</p>
    </div>

    <div class="reg-field">
      <label class="reg-label" for="reg-name">Full Name</label>
      <input id="reg-name" type="text" name="fullName" required placeholder="Enter your name" class="reg-input" />
    </div>

    <div class="reg-field">
      <label class="reg-label" for="reg-email">Email Address</label>
      <input id="reg-email" type="email" name="email" required placeholder="email@example.com" class="reg-input" />
    </div>

    <div class="reg-field">
      <label class="reg-label" for="reg-phone">Phone Number</label>
      <div class="reg-phone-row">
        <select name="countryCode" class="reg-country-select" aria-label="Country code">
