---
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
    <title>Book Your Strategy Call — Droparabia</title>
    <link rel="icon" type="image/png" href="/Droparabia.webp" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>

  <body>

    <!-- Hero -->
    <section class="book-hero">
      <h1 class="book-heading">Book Your Free 45-Min Strategy Call</h1>
      <p class="spots-sub" id="spots-badge">
        <span id="spots-text">Checking for spots left...</span>
      </p>
    </section>

    <!-- Main content -->
    <main class="book-main">

      <!-- Calendly widget (shown when spots available) -->
      <div id="calendly-wrap">
        <div class="calendly-inline-widget" data-url="https://calendly.com/d/dvzh-7y8-6s2/45-min-webinar-strategy-call" style="min-width:320px;height:700px;"></div>
        <script type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async></script>
      </div>

      <!-- Waitlist form (shown when spots are full) -->
      <div id="waitlist-wrap" class="hidden">
        <div class="confirm-card">
          <div class="confirm-icon full">✗</div>
          <h2 class="confirm-title">All spots are taken</h2>
          <p class="confirm-desc">Join the waitlist and we'll notify you if a spot opens up.</p>
          <form id="waitlist-form" class="book-form">
            <div class="form-row">
              <div class="form-group">
                <label>First Name</label>
                <input type="text" name="firstName" required placeholder="First name" />
              </div>
              <div class="form-group">
                <label>Last Name</label>
                <input type="text" name="lastName" placeholder="Last name" />
              </div>
            </div>
            <div class="form-group">
              <label>Email</label>
              <input type="email" name="email" required placeholder="you@example.com" />
            </div>
            <div class="form-group">
              <label>Phone Number</label>
              <div class="phone-row">
