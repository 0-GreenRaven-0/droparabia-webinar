---
import FlipClock from './FlipClock.astro';
---

<section class="hero-section relative">
  <div class="circle circle-img -left-130 hidden sm:block"/>
  <div class="circle circle-img-mj -right-130 hidden sm:block"/>
  <div class="circle circle-img-mj circle-mobile sm:hidden"/>

  <!-- Logo + Brand -->
  <div class="hero-brand">
    <img src="/Droparabia.png" alt="Droparabia" class="hero-logo" />
    <span class="hero-brand-name">Droparabia</span>
  </div>

  <div class="hero-content">
    <!-- Attention Line -->
    <p class="hero-attention">After this <span class="hero-highlight">FREE</span> workshop, you'll walk away knowing exactly how to</p>

    <!-- Headline -->
    <h1 class="hero-headline">Build a <span class="hero-gradient-text">profitable</span> online store in Lebanon without ever touching Inventory</h1>

    <!-- Subheadline -->
    <p class="hero-subheadline"><strong>Don't waste your money on courses and mentorships</strong>, <br/> Majd Abdulsalam will teach everything you need to know from A to Z</p>

    <!-- CTA -->
    <a href="#register" class="hero-cta" onclick="event.preventDefault(); document.getElementById('regModal').classList.add('show')">Secure your spot NOW!!!</a>

    <!-- Counter -->
    <div class="hero-counter">
      <FlipClock targetDate="2026-06-23 00:00:00" />
    </div>
  </div>

  <!-- Testimonial heading (mobile only) -->
  <div class="hero-testo-heading sm:hidden">
    <h2 class="text-2xl font-normal text-center text-black leading-tight">
      Yes It's possible<br/>
      <span class="text-cyan-600">+600 Lebanese</span> already did it
    </h2>
    <div class="flex items-center justify-center gap-3 mt-3">
      <svg width="20" height="28" viewBox="0 0 20 28" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M10 2L10 22M4 16L10 24L16 16" stroke="black" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <svg width="20" height="28" viewBox="0 0 20 28" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M10 2L10 22M4 16L10 24L16 16" stroke="black" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </div>
  </div>
</section>
