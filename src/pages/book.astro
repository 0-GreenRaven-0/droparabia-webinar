    <style is:global>
      html, body { margin: 0; padding: 0; background: #F0F0F0; }
    </style>

    <style>
      * { box-sizing: border-box; }

      body {
        font-family: 'Outfit', sans-serif;
        color: #000;
        min-height: 100vh;
      }

      /* ── Hero ── */
      .book-hero {
        background: #F0F0F0;
        padding: 56px 24px 48px;
        text-align: center;
        color: #000;
      }
      .book-heading {
        font-family: 'IBrand', sans-serif;
        font-size: clamp(2rem, 6vw, 3.2rem);
        font-weight: 400;
        margin: 0 0 16px;
        line-height: 1.1;
        letter-spacing: -0.01em;
      }
      /* ── Spots subheading ── */
      .spots-sub {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        font-size: clamp(1rem, 2.5vw, 1.25rem);
        font-weight: 500;
        color: #444;
        margin: 0;
      }
      .spots-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #ff4444;
        animation: pulse 1.5s ease-in-out infinite;
        flex-shrink: 0;
      }
      .spots-sub.full .spots-dot { background: #888; animation: none; }
      @keyframes pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50%       { opacity: 0.5; transform: scale(0.8); }
      }

      /* ── Main ── */
      .book-main {
        max-width: 860px;
        margin: 0 auto;
        padding: 40px 24px 60px;
      }

      #calendly-wrap {
        background: #fff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 24px rgba(0,0,0,0.08);
      }

      /* ── Cards ── */
      .confirm-card {
        background: #fff;
        border-radius: 16px;
        padding: 48px 40px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.08);
        max-width: 560px;
        margin: 0 auto;
        text-align: center;
      }
      .confirm-icon {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: #020887;
        color: #fff;
        font-size: 1.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
      }
      .confirm-icon.full { background: #888; }
      .confirm-title {
        font-family: 'IBrand', sans-serif;
        font-size: clamp(1.6rem, 4vw, 2.2rem);
        font-weight: 400;
        margin: 0 0 10px;
        letter-spacing: -0.01em;
      }
      .confirm-desc {
        color: #555;
        font-size: 1rem;
        margin: 0 0 28px;
        line-height: 1.6;
      }
      .thankyou-card .confirm-desc { margin-bottom: 0; }

      /* ── Form ── */
      .book-form {
        display: flex;
        flex-direction: column;
        gap: 14px;
        text-align: left;
      }
      .form-row {
        display: flex;
        gap: 12px;
      }
      .form-group {
        display: flex;
        flex-direction: column;
        gap: 4px;
        flex: 1;
      }
      .form-group label {
        font-size: 0.85rem;
        color: #555;
        font-weight: 500;
      }
      .form-group input {
        padding: 12px 14px;
        border: 1.5px solid #ddd;
        border-radius: 10px;
        font-family: 'Outfit', sans-serif;
        font-size: 0.95rem;
        color: #000;
        background: #fafafa;
        outline: none;
        transition: border-color 0.2s;
        width: 100%;
      }
      .form-group input:focus { border-color: #020887; background: #fff; }
      .form-group input::placeholder { color: #aaa; }

      .phone-row {
        display: flex;
        border: 1.5px solid #ddd;
        border-radius: 10px;
        overflow: hidden;
        background: #fafafa;
        transition: border-color 0.2s;
      }
      .phone-row:focus-within { border-color: #020887; background: #fff; }
      .country-select {
        flex-shrink: 0;
        border: none;
        border-right: 1.5px solid #ddd;
        background: transparent;
        font-family: 'Outfit', sans-serif;
        font-size: 0.9rem;
        color: #000;
        padding: 12px 8px 12px 12px;
        outline: none;
        cursor: pointer;
      }
      .phone-input {
        flex: 1;
        border: none !important;
        border-radius: 0 !important;
        background: transparent !important;
        min-width: 0;
      }

      .book-btn {
        margin-top: 6px;
        padding: 14px;
        background: #020887;
        color: #fff;
        border: none;
        border-radius: 10px;
        font-family: 'Outfit', sans-serif;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
        width: 100%;
      }
      .book-btn:hover { background: #0a14b8; }
      .book-btn:disabled { background: #aaa; cursor: not-allowed; }

      .form-msg {
        font-size: 0.9rem;
        text-align: center;
        margin: 0;
      }
      .form-msg.error { color: #cc0000; }
      .form-msg.success { color: #007700; }

      .hidden { display: none !important; }

      @media (max-width: 480px) {
        .form-row { flex-direction: column; }
        .confirm-card { padding: 32px 20px; }
      }
    </style>

    <script is:inline>
      (async function () {
        const spotsText  = document.getElementById('spots-text');
        const spotsBadge = document.getElementById('spots-badge');
        const calendlyWrap = document.getElementById('calendly-wrap');
        const waitlistWrap = document.getElementById('waitlist-wrap');

        let spotsRemaining = 10;

        try {
          const res  = await fetch('/api/book-spots');
          const data = await res.json();
          spotsRemaining = data.remaining ?? 10;

          if (spotsRemaining <= 0) {
            spotsText.textContent = 'All 10 spots are taken';
            spotsBadge.classList.add('full');
            calendlyWrap.classList.add('hidden');
            waitlistWrap.classList.remove('hidden');
          } else {
            spotsText.textContent = spotsRemaining + ' of 10 spots remaining';
          }
        } catch {
          spotsText.textContent = 'Limited spots remaining';
        }

        // Listen for Calendly booking event → increment counter → show thank you
        window.addEventListener('message', async function (e) {
          if (e.data && e.data.event === 'calendly.event_scheduled') {
            calendlyWrap.classList.add('hidden');

            try {
              const res = await fetch('/api/book', { method: 'POST' });
              const result = await res.json();

              if (result.full) {
                spotsText.textContent = 'All 10 spots are taken';
                spotsBadge.classList.add('full');
                waitlistWrap.classList.remove('hidden');
              } else {
                document.getElementById('thankyou-wrap').classList.remove('hidden');
                window.scrollTo({ top: 0, behavior: 'smooth' });
              }
            } catch {
              document.getElementById('thankyou-wrap').classList.remove('hidden');
              window.scrollTo({ top: 0, behavior: 'smooth' });
            }
          }
        });

        // Waitlist form submit
        document.getElementById('waitlist-form').addEventListener('submit', async function (e) {
          e.preventDefault();
          const form = e.target;
          const btn  = form.querySelector('button[type="submit"]');
          const msg  = document.getElementById('waitlist-msg');

          btn.disabled = true;
          btn.textContent = 'Submitting...';
          msg.classList.add('hidden');

          try {
            var wlCode = form.countryCode.value || '+961';
            var wlDigits = form.phone.value.replace(/\D/g, '');
            var wlPrefix = wlCode.replace('+', '');
            if (wlDigits.startsWith(wlPrefix)) wlDigits = wlDigits.slice(wlPrefix.length);
            if (wlCode === '+961' && wlDigits.startsWith('0')) wlDigits = wlDigits.slice(1);

            const res = await fetch('/api/waitlist', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                firstName: form.firstName.value.trim(),
                lastName:  form.lastName.value.trim(),
                email:     form.email.value.trim(),
                phone:     wlCode + wlDigits,
              }),
            });
            const result = await res.json();

            if (result.success) {
              document.getElementById('waitlist-wrap').classList.add('hidden');
              const ty = document.getElementById('thankyou-wrap');
              document.getElementById('ty-heading').textContent = "You're on the waitlist!";
              document.getElementById('ty-desc').textContent = "We'll reach out as soon as a spot opens up.";
              ty.classList.remove('hidden');
            } else {
              msg.textContent = 'Something went wrong. Please try again.';
              msg.className = 'form-msg error';
              msg.classList.remove('hidden');
              btn.disabled = false;
              btn.textContent = 'Join the Waitlist';
            }
          } catch {
            msg.textContent = 'Something went wrong. Please try again.';
            msg.className = 'form-msg error';
            msg.classList.remove('hidden');
            btn.disabled = false;
            btn.textContent = 'Join the Waitlist';
          }
        });
      })();
    </script>

