  // Greet them by the first name the registration form passed through.
  (function () {
    var n = new URLSearchParams(window.location.search).get('name');
    if (!n) return;
    var first = decodeURIComponent(n).trim().split(/\s+/)[0];
    if (first) document.getElementById('confirm-name').textContent = ', ' + first;
  })();

  function tyScroll(dir) {
    var t = document.getElementById('ty-track');
    var sl = t.querySelector('.ty-slide');
    var step = sl ? sl.getBoundingClientRect().width + 16 : 300;
    if (dir > 0 && t.scrollLeft + t.clientWidth >= t.scrollWidth - 5) { t.scrollTo({ left: 0 }); return; }
    if (dir < 0 && t.scrollLeft <= 5) { t.scrollTo({ left: t.scrollWidth }); return; }
    t.scrollBy({ left: dir * step });
  }
</script>
