---
---

<header class="site-header" id="site-header">
  <!-- Desktop (hidden — hero has its own) -->
  <div class="header-desktop hidden">
    <div class="flex items-center gap-3">
      <img src="/Droparabia.png" alt="Droparabia" class="hero-logo" />
      <span class="header-brand-name">Droparabia</span>
    </div>
    <nav class="header-nav">
      <a href="#testimonials" class="header-nav-link">Testimonials</a>
      <a href="#learn-section" class="header-nav-link">What You'll Learn</a>
      <a href="#faq" class="header-nav-link">FAQ</a>
      <a href="#register" class="header-nav-link">Register</a>
    </nav>
  </div>

  <!-- Mobile -->
  <div class="header-mobile sm:hidden">
    <div class="flex items-center gap-2">
      <img src="/Droparabia.png" alt="Droparabia" class="h-11 w-auto object-contain" />
      <span class="header-brand-name-mobile">Droparabia</span>
    </div>
    <button class="hero-hamburger" id="hamburger-btn" aria-label="Menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<!-- Mobile: Overlay -->
<div class="hero-mobile-overlay" id="mobile-overlay"></div>

<!-- Mobile: Slide-out menu -->
<div class="hero-mobile-menu" id="mobile-menu">
  <button class="hero-menu-close" id="menu-close-btn" aria-label="Close menu">✕</button>
  <nav class="hero-mobile-menu-nav">
    <a href="#" class="hero-mobile-menu-link active">Home</a>
    <a href="#learn-section" class="hero-mobile-menu-link">What You'll Learn</a>
    <a href="#host-section" class="hero-mobile-menu-link">Founder</a>
    <a href="#testimonials" class="hero-mobile-menu-link">Results</a>
    <a href="#register" class="hero-mobile-menu-cta">Register Now</a>
  </nav>
</div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 200;
    transition: background 0.3s ease, box-shadow 0.3s ease;
  }

  .header-desktop {
    align-items: center;
    justify-content: space-between;
    padding: 12px 48px;
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .header-brand-name {
    font-family: 'IBrand', sans-serif;
    font-size: 1.75rem;
    letter-spacing: -0.01em;
    color: #fff;
    transition: color 0.3s ease;
  }

  .header-brand-name-mobile {
    font-family: 'IBrand', sans-serif;
    font-size: 1.5rem;
    letter-spacing: -0.01em;
    color: #fff;
    transition: color 0.3s ease;
  }

  .header-nav-link {
    font-family: 'IBrand', sans-serif;
    font-size: 0.875rem;
    color: #fff;
    text-decoration: none;
    position: relative;
    transition: color 0.3s ease;
  }
  .header-nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 2px;
    background: #60a5fa;
    transform: translateX(-50%);
    transition: width 0.3s ease, background 0.3s ease;
  }
  .header-nav-link:hover::after {
    width: 100%;
  }

  .header-mobile {
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
  }

  /* Scrolled state */
  .site-header.scrolled {
    background: #fff;
    box-shadow: 0 2px 12px rgba(0,0,0,0.08);
  }
  .site-header.scrolled .header-brand-name,
  .site-header.scrolled .header-brand-name-mobile {
    color: #000;
  }
  .site-header.scrolled .header-nav-link {
    color: #000;
  }
  .site-header.scrolled .header-nav-link::after {
    background: #2563eb;
  }
  .site-header.scrolled .hero-hamburger span {
    background: #000;
  }

  /* Hamburger */
  .hero-hamburger {
    display: flex;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }
  .hero-hamburger span {
    display: block;
    width: 24px;
    height: 2px;
    background: #fff;
    border-radius: 2px;
    transition: transform 0.3s ease, opacity 0.3s ease, background 0.3s ease;
  }
  .hero-hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .hero-hamburger.open span:nth-child(2) { opacity: 0; }
  .hero-hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* Overlay & menu */
  .hero-mobile-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.4);
    z-index: 199;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .hero-mobile-overlay.open {
    opacity: 1;
    pointer-events: auto;
  }
  .hero-mobile-menu {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 280px;
    background: #fff;
    border-left: 3px solid #2563eb;
    z-index: 200;
    display: flex;
    flex-direction: column;
    padding: 72px 28px 32px;
    transform: translateX(100%);
    transition: transform 0.3s ease;
  }
  .hero-mobile-menu.open { transform: translateX(0); }
  .hero-menu-close {
    position: absolute;
    top: 16px;
    right: 20px;
    background: none;
    border: none;
    color: #000;
    font-size: 24px;
    cursor: pointer;
  }
  .hero-mobile-menu-nav {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
  }
  .hero-mobile-menu-link {
    font-family: 'IBrand', sans-serif;
    font-size: 22px;
    color: #000;
    text-decoration: none;
  }
  .hero-mobile-menu-link.active { color: #2563eb; }
  .hero-mobile-menu-cta {
    font-family: 'IBrand', sans-serif;
    font-size: 18px;
    color: #fff;
    text-decoration: none;
    background: rgb(20, 173, 0);
    padding: 14px 32px;
    border-radius: 14px;
    margin-top: 16px;
    box-shadow: 0 6px 0 rgb(7, 97, 12), 0 14px 28px rgba(0,0,0,0.2);
  }

  @media (min-width: 640px) {
    .header-mobile { display: none !important; }
    .hero-mobile-menu { display: none !important; }
    .hero-mobile-overlay { display: none !important; }
  }
</style>

<script is:inline>
  const header = document.getElementById('site-header');
  const btn = document.getElementById('hamburger-btn');
  const menu = document.getElementById('mobile-menu');
  const overlay = document.getElementById('mobile-overlay');
  const closeBtn = document.getElementById('menu-close-btn');

  window.addEventListener('scroll', () => {
    header.classList.toggle('scrolled', window.scrollY > 50);
  });

  function openMenu() { btn.classList.add('open'); menu.classList.add('open'); overlay.classList.add('open'); }
  function closeMenu() { btn.classList.remove('open'); menu.classList.remove('open'); overlay.classList.remove('open'); }

  btn.addEventListener('click', openMenu);
  closeBtn.addEventListener('click', closeMenu);
  overlay.addEventListener('click', closeMenu);
  menu.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu));
</script>
