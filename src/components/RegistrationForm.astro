    if (!dd) return;
    var btn = document.getElementById('reg-intent-btn');
    var list = document.getElementById('reg-intent-list');
    var valueEl = document.getElementById('reg-intent-value');
    var input = document.getElementById('reg-intent');
    var opts = Array.prototype.slice.call(list.querySelectorAll('.reg-dd-opt'));
    var activeIndex = -1;

    function setActive(i) {
      activeIndex = i;
      opts.forEach(function (o, n) { o.classList.toggle('is-active', n === i); });
      if (opts[i]) opts[i].scrollIntoView({ block: 'nearest' });
    }

    var hideTimer;

    function open() {
      clearTimeout(hideTimer);
      list.hidden = false;
      // Unhide first, then flip the class on the next frame so the browser has a
      // painted "closed" state to animate away from.
      requestAnimationFrame(function () { dd.classList.add('is-open'); });
      btn.setAttribute('aria-expanded', 'true');
      setActive(opts.findIndex(function (o) { return o.getAttribute('aria-selected') === 'true'; }));

    }

    function close() {
      dd.classList.remove('is-open');
      btn.setAttribute('aria-expanded', 'false');
      setActive(-1);
      // Re-hide only once it has faded out, so it leaves the tab order again.
      clearTimeout(hideTimer);
      hideTimer = setTimeout(function () { list.hidden = true; }, 200);
    }

    function choose(opt) {
      opts.forEach(function (o) { o.setAttribute('aria-selected', String(o === opt)); });
      // dataset holds the raw answer; textContent is the same string, already
      // entity-decoded by the parser, so either works — dataset keeps them in sync.
      input.value = opt.dataset.value;
      valueEl.textContent = opt.dataset.value;
      valueEl.classList.remove('is-placeholder');
      dd.classList.remove('is-invalid');
      close();
      btn.focus();
    }

    btn.addEventListener('click', function () {
      if (list.hidden) open(); else close();
    });

    opts.forEach(function (opt, i) {
      opt.addEventListener('click', function () { choose(opt); });
      // The keyboard highlight follows the mouse, so only one option is ever
      // highlighted — otherwise the already-selected one would stay lit up
      // alongside whatever is under the cursor.
      opt.addEventListener('mouseenter', function () { setActive(i); });
    });

    // Keyboard support, so the control behaves like the select it replaced.
    dd.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') { close(); btn.focus(); return; }
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        if (list.hidden) { open(); return; }
        var next = activeIndex + (e.key === 'ArrowDown' ? 1 : -1);
        setActive(Math.max(0, Math.min(opts.length - 1, next)));
        return;
      }
      if ((e.key === 'Enter' || e.key === ' ') && !list.hidden) {
        e.preventDefault();
        if (opts[activeIndex]) choose(opts[activeIndex]);
      }
    });

    document.addEventListener('click', function (e) {
      if (!dd.contains(e.target)) close();
    });
  })();
</script>
