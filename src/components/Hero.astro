---
import FlipClock from './FlipClock.astro';
---

<!-- Mobile overlay + menu -->
<div class="mobile-overlay" id="mobile-overlay"></div>
<div class="mobile-menu" id="mobile-menu">
  <button class="menu-close" id="menu-close-btn" aria-label="Close menu">✕</button>
  <nav class="mobile-menu-nav">
    <a href="#who-section" class="mobile-menu-link">Who is this for</a>
    <a href="#learn-section" class="mobile-menu-link">What You'll Learn</a>
    <a href="#host-section-mobile" class="mobile-menu-link">Your Host</a>
    <a href="#testimonials" class="mobile-menu-link">Results you'll get</a>
    <a href="#register" class="mobile-menu-cta">Register Now</a>
    <div class="menu-counter mt-2" style="display:flex; align-items:center; gap:8px; font-family:'IBrand',sans-serif;">
      <div style="display:flex; flex-direction:column; align-items:center;">
        <span class="cd-days" style="font-size:1.5rem; color:#000;">00</span>
        <span style="font-size:0.6rem; color:#000; text-transform:uppercase;">Days</span>
      </div>
      <span style="font-size:1.2rem; color:#000; margin-bottom:12px;">:</span>
      <div style="display:flex; flex-direction:column; align-items:center;">
        <span class="cd-hours" style="font-size:1.5rem; color:#000;">00</span>
        <span style="font-size:0.6rem; color:#000; text-transform:uppercase;">Hours</span>
      </div>
      <span style="font-size:1.2rem; color:#000; margin-bottom:12px;">:</span>
      <div style="display:flex; flex-direction:column; align-items:center;">
        <span class="cd-minutes" style="font-size:1.5rem; color:#000;">00</span>
        <span style="font-size:0.6rem; color:#000; text-transform:uppercase;">Min</span>
      </div>
      <span style="font-size:1.2rem; color:#000; margin-bottom:12px;">:</span>
      <div style="display:flex; flex-direction:column; align-items:center;">
        <span class="cd-seconds" style="font-size:1.5rem; color:#000;">00</span>
        <span style="font-size:0.6rem; color:#000; text-transform:uppercase;">Sec</span>
      </div>
    </div>
  </nav>
</div>

<section class="hero-section relative" id="hero-section">
  <div class="hero-overlay lg:hidden"></div>
  <div class="circle circle-img -left-130 hidden lg:block"/>
  <div class="circle circle-img-mj -right-130 hidden lg:block"/>

  <!-- Desktop: Logo + Brand + Nav -->
  <div class="hero-brand hidden lg:flex">
    <img src="/Droparabia.webp" alt="Droparabia" class="hero-logo" />
    <span class="hero-brand-name">Droparabia</span>
    <span class="hero-attention hidden sm:inline-flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-blue-500 shrink-0"></span>LIVE WORKSHOP</span>
  </div>
  <nav class="hero-nav">
    <a href="#who-section" class="hero-nav-link">Who is this for</a>
    <a href="#learn-section" class="hero-nav-link">What You'll Learn</a>
    <a href="#host-section" class="hero-nav-link">Your Host</a>
    <a href="#testimonials" class="hero-nav-link">Results you'll get</a>
  </nav>

  <!-- Mobile: Header bar -->
  <div class="hero-mobile-header lg:hidden" style="display:flex; align-items:center; justify-content:space-between; padding:12px 16px; position:relative; z-index:60;">
    <div style="display:flex; align-items:center; gap:8px;">
      <img src="/Droparabia.webp" alt="Droparabia" style="height:44px; width:auto; object-fit:contain;" />
      <span style="font-family:'IBrand',sans-serif; font-size:1.5rem; letter-spacing:-0.01em; color:#fff;">Droparabia</span>
    </div>
    <button id="hamburger-btn" aria-label="Menu" style="display:flex; flex-direction:column; gap:5px; background:none; border:none; cursor:pointer; padding:4px;">
      <span style="display:block; width:24px; height:2px; background:#fff; border-radius:2px;"></span>
      <span style="display:block; width:24px; height:2px; background:#fff; border-radius:2px;"></span>
      <span style="display:block; width:24px; height:2px; background:#fff; border-radius:2px;"></span>
    </button>
  </div>

  <div class="hero-content">
    <p class="hero-attention lg:hidden"><span class="inline-block w-2 h-2 rounded-full bg-blue-500 mr-2 align-middle"></span>LIVE WORKSHOP</p>
    <h1 class="hero-headline">How to build a <span class="hero-gradient-text">high-earning</span> online store <span class="neon-underline lg:underline lg:decoration-blue-600 lg:underline-offset-4 lg:decoration-[3px]">without ever touching inventory</span></h1>
    <p class="hero-subheadline">Learn from A to Z how to launch your own profitable and a successful online store<br/><strong><em class="text-sm sm:text-base">without purchasing courses and mentorships!</em></strong></p>
    <a href="#register" class="hero-cta" id="hero-cta">
      Secure Your Spot Now
      <span class="cta-spots"><span class="spots-count">267</span> spots remaining!</span>
    </a>
    <div class="hero-counter">
      <FlipClock targetDate="2026-07-13 18:30:00" />
    </div>
  </div>
</section>

<style>
  @media (max-width: 1023px) {
    .neon-underline {
      text-decoration: none;
    }
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.55);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    z-index: 1;
    pointer-events: none;
  }

  .hero-mobile-header {
    position: relative;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
  }

  .hero-hamburger {
    display: flex;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }
  .hero-hamburger span {
    display: block;
    width: 24px;
    height: 2px;
    background: #fff;
    border-radius: 2px;
  }

  .mobile-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.4);
    z-index: 199;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .mobile-overlay.open { opacity: 1; pointer-events: auto; }

  .mobile-menu {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 280px;
    background: #fff;
    border-left: 3px solid #2563eb;
    z-index: 200;
    display: flex;
    flex-direction: column;
    padding: 72px 28px 32px;
    transform: translateX(100%);
    transition: transform 0.3s ease;
  }
  .mobile-menu.open { transform: translateX(0); }

  .menu-close {
    position: absolute;
    top: 16px;
    right: 20px;
    background: none;
    border: none;
    color: #000;
    font-size: 24px;
    cursor: pointer;
  }
  .mobile-menu-nav {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
  }
  .mobile-menu-link {
    font-family: 'IBrand', sans-serif;
    font-size: 22px;
    color: #000;
    text-decoration: none;
  }
  .mobile-menu-link.active { color: #2563eb; }
  .menu-counter span {
    color: #000 !important;
  }

  .mobile-menu-cta {
    font-family: 'Outfit', sans-serif;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #fff;
    text-decoration: none;
    background: rgb(20, 173, 0);
    padding: 14px 32px;
    border-radius: 4px;
    margin-top: 16px;
    transition: background 0.2s ease;
  }

  @media (min-width: 1024px) {
    .hero-mobile-header { display: none !important; }
    .mobile-overlay { display: none !important; }
    .mobile-menu { display: none !important; }
  }

  .hero-cta {
    display: inline-flex !important;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }
  .cta-spots {
    font-size: 0.85em;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #fff;
  }
  .spots-count {
    font-weight: 700;
    color: #ff4444;
  }
</style>

<script is:inline>
  fetch('/api/spots')
    .then(r => r.json())
    .then(data => {
      document.querySelectorAll('.spots-count').forEach(el => {
        el.textContent = String(data.remaining ?? 267);
      });
    })
    .catch(() => {});

  const overlay = document.getElementById('mobile-overlay');
  const menu = document.getElementById('mobile-menu');
  const closeBtn = document.getElementById('menu-close-btn');
  const hamburger = document.getElementById('hamburger-btn');

  function openMenu() { menu.classList.add('open'); overlay.classList.add('open'); }
  function closeMenu() { menu.classList.remove('open'); overlay.classList.remove('open'); }

  if (hamburger) hamburger.addEventListener('click', openMenu);
  closeBtn.addEventListener('click', closeMenu);
  overlay.addEventListener('click', closeMenu);
  menu.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu));

  // Swap CTA to Zoom link when webinar goes live
  (function() {
    var ZOOM = 'https://us06web.zoom.us/j/82230789524?pwd=K6FlWw4FbHlPNCyfRFhGUevaaweArl.1';
    var target = new Date('2026-07-13T18:30:00').getTime();

    function checkLive() {
      if (Date.now() < target) return;
      var cta = document.getElementById('hero-cta');
      if (!cta) return;
      cta.href = ZOOM;
      cta.target = '_blank';
      cta.rel = 'noopener noreferrer';
      cta.innerHTML = '<span style="font-size:1.1em;font-weight:800;letter-spacing:0.03em;">THE MEETING IS HAPPENING NOW</span><span style="font-size:0.9em;font-weight:600;margin-top:2px;">Click here to join quickly!!!</span>';
      clearInterval(liveInterval);
    }

    var liveInterval = setInterval(checkLive, 1000);
    checkLive();
  })();
</script>
