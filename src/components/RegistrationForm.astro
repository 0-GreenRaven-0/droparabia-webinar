      '+236': 8, '+237': 9, '+238': 7, '+239': 7, '+240': 9,
      '+241': 7, '+242': 9, '+243': 9, '+244': 9, '+245': 7,
      '+246': 7, '+247': 4, '+248': 7, '+249': 9, '+250': 9,
      '+251': 9, '+252': 8, '+253': 8, '+254': 9, '+255': 9,
      '+256': 9, '+257': 8, '+258': 9, '+260': 9, '+261': 9,
      '+262': 9, '+263': 9, '+264': 9, '+265': 9, '+266': 8,
      '+267': 8, '+268': 8, '+269': 7, '+290': 4, '+291': 7,
      '+297': 7, '+298': 6, '+299': 6,
      '+350': 8, '+351': 9, '+352': 9, '+353': 9, '+354': 7,
      '+355': 9, '+356': 8, '+357': 8, '+358': 9, '+359': 9,
      '+370': 8, '+371': 8, '+372': 8, '+373': 8, '+374': 8,
      '+375': 9, '+376': 6, '+377': 8, '+378': 10, '+380': 9,
      '+381': 9, '+382': 8, '+383': 8, '+385': 9, '+386': 8,
      '+387': 8, '+389': 8, '+420': 9, '+421': 9, '+423': 7,
      '+500': 5, '+501': 7, '+502': 8, '+503': 8, '+504': 8,
      '+505': 8, '+506': 8, '+507': 8, '+508': 6, '+509': 8,
      '+590': 9, '+591': 8, '+592': 7, '+593': 9, '+595': 9,
