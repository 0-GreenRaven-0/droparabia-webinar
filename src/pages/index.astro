---
import '../styles/global.css';
import Hero from '../components/Hero.astro';
import WorkshopSection from '../components/WorkshopSection.astro';
import HostSection from '../components/HostSection.astro';
import LearnSection from '../components/LearnSection.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';


---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
    <meta name="generator" content={Astro.generator} />

    <title>Droparabia — Free Live Workshop</title>
    <meta
      name="description"
      content="Join Majd Abdulsalam in a live workshop and learn how to build a profitable dropshipping business in Lebanon using Droparabia — from scratch, step by step."
    />

    <link rel="icon" type="image/png" href="/Droparabia.webp" />
    <link rel="preload" as="image" href="/mj4.png" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="overflow-x-hidden" style="background: #F0F0F0;">

    <Hero />
    <Testimonials />
    <WorkshopSection />
    <HostSection />
    <LearnSection />

    <FAQ />

    <!-- Registration Form -->
    <section id="register" class="py-20 px-6" style="background: #F0F0F0;">
      <div class="max-w-md mx-auto">
        <h2 class="text-3xl sm:text-4xl font-normal text-black text-center mb-8" style="font-family: 'IBrand', sans-serif;">
          Secure your spot now!
        </h2>
        <form id="webinar-form" class="flex flex-col gap-4">
          <div class="flex gap-4">
            <div class="flex-1">
              <label class="block text-sm text-black/60 mb-1" style="font-family: 'Outfit', sans-serif;">First Name</label>
              <input type="text" name="firstName" required placeholder="First name" class="w-full rounded-xl px-4 py-3 bg-white border border-gray-400 text-black placeholder:text-black/30 focus:outline-none focus:border-gray-400" style="font-family: 'Outfit', sans-serif;" />
            </div>
            <div class="flex-1">
              <label class="block text-sm text-black/60 mb-1" style="font-family: 'Outfit', sans-serif;">Last Name</label>
              <input type="text" name="lastName" placeholder="Last name" class="w-full rounded-xl px-4 py-3 bg-white border border-gray-400 text-black placeholder:text-black/30 focus:outline-none focus:border-gray-400" style="font-family: 'Outfit', sans-serif;" />
            </div>
          </div>
          <div>
            <label class="block text-sm text-black/60 mb-1" style="font-family: 'Outfit', sans-serif;">Phone Number</label>
            <div class="flex items-center gap-2 rounded-xl px-4 py-3 bg-white border border-gray-400">
              <span class="text-black/40 text-sm shrink-0">+961</span>
              <input type="tel" name="phone" required placeholder="XX XXX XXX" maxlength="10" class="flex-1 bg-transparent text-black placeholder:text-black/30 focus:outline-none" style="font-family: 'Outfit', sans-serif;" />
            </div>
          </div>
          <div>
            <label class="block text-sm text-black/60 mb-1" style="font-family: 'Outfit', sans-serif;">Email</label>
            <input type="email" name="email" required placeholder="your@email.com" class="w-full rounded-xl px-4 py-3 bg-white border border-gray-400 text-black placeholder:text-black/30 focus:outline-none focus:border-gray-400" style="font-family: 'Outfit', sans-serif;" />
          </div>
          <button type="submit" class="mt-2 w-full px-8 py-4 text-white text-lg cursor-pointer border-none font-semibold uppercase tracking-wider" style="font-family: 'Outfit', sans-serif; background: rgb(20, 173, 0); border-radius: 4px; transition: background 0.2s ease, transform 0.15s ease;">
            Register Now!
          </button>
          <p id="form-msg" class="text-center text-sm hidden" style="font-family: 'Outfit', sans-serif;"></p>
        </form>
      </div>
    </section>

    <script is:inline>
      document.getElementById('webinar-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const form = e.target;
        const btn = form.querySelector('button[type="submit"]');
        const msg = document.getElementById('form-msg');
        const data = {
          firstName: form.firstName.value.trim(),
          lastName: form.lastName.value.trim(),
          phone: '+961' + form.phone.value.replace(/\D/g, ''),
          email: form.email.value.trim(),
        };
        btn.disabled = true;
        btn.textContent = 'Submitting...';
        msg.classList.add('hidden');
        try {
          const res = await fetch('/api/register', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data),
          });
          const result = await res.json();
          if (result.success) {
            const fullName = [data.firstName, data.lastName].filter(Boolean).join(' ');
            window.location.href = '/confirm?name=' + encodeURIComponent(fullName);
          } else {
            msg.textContent = result.error || 'Something went wrong. Try again.';
            msg.classList.remove('hidden');
            msg.style.color = '#dc2626';
          }
        } catch {
          msg.textContent = 'Network error. Please try again.';
          msg.classList.remove('hidden');
          msg.style.color = '#dc2626';
        }
        btn.disabled = false;
        btn.textContent = 'Register Now!';
      });
    </script>

    <!-- Footer -->
    <footer class="footer-section">
      <div class="footer-inner">
        <div class="footer-brand">
          <a href="/" class="footer-logo-link">
            <img src="/Droparabia.webp" alt="Droparabia logo" class="footer-logo-img" />
            <span class="footer-logo-name">Droparabia</span>
          </a>
        </div>
        <div class="footer-links">
          <p class="footer-links-label">Legal</p>
          <div class="footer-compliance">
            <a href="/privacy-policy" class="footer-compliance-link">Privacy Policy</a>
            <a href="/terms" class="footer-compliance-link">Terms &amp; Conditions</a>
          </div>
        </div>
        <div class="footer-links">
          <p class="footer-links-label">Follow us</p>
          <div class="footer-socials">
            <a href="https://www.instagram.com/mjbusinessofficial" target="_blank" rel="noopener" class="footer-social-link" aria-label="Instagram">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M7.0301.084c-1.2768.0602-2.1487.264-2.911.5634-.7888.3075-1.4575.72-2.1228 1.3877-.6652.6677-1.075 1.3368-1.3802 2.127-.2954.7638-.4956 1.6365-.552 2.914-.0564 1.2775-.0689 1.6882-.0626 4.947.0062 3.2586.0206 3.6671.0825 4.9473.061 1.2765.264 2.1482.5635 2.9107.308.7889.72 1.4573 1.388 2.1228.6679.6655 1.3365 1.0743 2.1285 1.38.7632.295 1.6361.4961 2.9134.552 1.2773.056 1.6884.069 4.9462.0627 3.2578-.0062 3.668-.0207 4.9478-.0814 1.28-.0607 2.147-.2652 2.9098-.5633.7889-.3086 1.4578-.72 2.1228-1.3881.665-.668 1.0745-1.3368 1.3795-2.1284.2957-.7632.4966-1.636.552-2.9124.056-1.2809.0692-1.6898.063-4.948-.0063-3.2583-.021-3.6668-.0817-4.9465-.0607-1.2797-.264-2.1487-.5633-2.9117-.3084-.7889-.72-1.4568-1.3876-2.1228C21.2982 1.33 20.628.9208 19.8504.6165 19.0872.321 18.2144.12 16.9418.0635 15.6647.0075 15.2531-.006 11.977.0001 8.7006.0061 8.2907.0208 7.0301.0839m.1402 21.6932c-1.17-.0509-1.8053-.2453-2.2287-.408-.5606-.216-.96-.4771-1.3819-.895-.422-.4178-.6811-.8186-.9-1.378-.1644-.4234-.3624-1.058-.4171-2.228-.0595-1.2645-.072-1.6442-.079-4.848-.007-3.2037.0053-3.583.0607-4.848.05-1.169.2456-1.805.408-2.2282.216-.5613.4762-.96.895-1.3816.4188-.4217.8184-.6814 1.3783-.9003.423-.1651 1.0575-.3614 2.227-.4171 1.2655-.06 1.6447-.072 4.848-.079 3.2033-.007 3.5835.005 4.8495.0608 1.169.0508 1.8053.2445 2.228.408.5608.216.96.4754 1.3816.895.4217.4194.6816.8176.9005 1.3787.1653.4217.3617 1.056.4169 2.2263.0602 1.2655.0739 1.645.0796 4.848.0058 3.203-.0055 3.5834-.061 4.848-.051 1.17-.245 1.8055-.408 2.2294-.216.5604-.4763.96-.8954 1.3814-.419.4215-.8181.6811-1.3783.9-.4224.1649-1.0577.3617-2.2262.4174-1.2656.0595-1.6448.072-4.8493.079-3.2045.007-3.5825-.006-4.848-.0608M16.953 5.5864A1.44 1.44 0 1 0 18.39 4.144a1.44 1.44 0 0 0-1.437 1.4424M5.8385 12.012c.0067 3.4032 2.7706 6.1557 6.173 6.1493 3.4026-.0065 6.157-2.7701 6.1506-6.1733-.0065-3.4032-2.771-6.1565-6.174-6.1498-3.403.0067-6.156 2.771-6.1496 6.1738M8 12.0077a4 4 0 1 1 4.008 3.9921A3.9996 3.9996 0 0 1 8 12.0077"/></svg>
            </a>
            <a href="https://www.youtube.com/@MJ.biznes" target="_blank" rel="noopener" class="footer-social-link" aria-label="YouTube">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            </a>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <p>© {new Date().getFullYear()} Droparabia. All rights reserved.</p>
      </div>
    </footer>

    <style>
      .footer-section { background: linear-gradient(135deg, #000c3d 0%, #001575 45%, #002199 70%, #001060 100%); padding: 48px 24px 0; }
      .footer-inner { max-width: 1040px; margin: 0 auto; display: flex; align-items: flex-start; justify-content: space-between; gap: 40px; flex-wrap: wrap; padding-bottom: 40px; border-bottom: 1px solid rgba(255,255,255,0.1); }
      .footer-brand { display: flex; flex-direction: column; gap: 12px; max-width: 280px; }
      .footer-logo-link { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; }
      .footer-logo-img { width: 56px; height: 56px; object-fit: contain; border-radius: 10px; }
      .footer-logo-name { font-family: 'IBrand', sans-serif; color: #fff; font-size: 2rem; }
      .footer-links { display: flex; flex-direction: column; gap: 12px; }
      .footer-links-label { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #fff; margin: 0; }
      .footer-socials { display: flex; align-items: center; gap: 10px; }
      .footer-social-link { display: flex; align-items: center; justify-content: center; width: 38px; height: 38px; border-radius: 10px; background: rgba(255,255,255,0.07); color: #fff; text-decoration: none; transition: background 0.15s, color 0.15s; }
      .footer-social-link svg { width: 18px; height: 18px; }
      .footer-social-link:hover { background: rgba(255,255,255,0.14); color: #fff; }
      .footer-compliance { display: flex; flex-direction: column; gap: 8px; }
      .footer-compliance-link { color: #fff; text-decoration: none; font-size: 0.9rem; transition: opacity 0.15s; }
      .footer-compliance-link:hover { opacity: 0.75; }
      .footer-bottom { max-width: 1040px; margin: 0 auto; padding: 20px 0; }
      .footer-bottom p { font-size: 0.8125rem; color: #fff; margin: 0; }
      @media (max-width: 768px) { .footer-inner { flex-direction: column; gap: 24px; } }
    </style>

  </body>
</html>
