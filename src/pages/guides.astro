---
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>7 Exclusive Guides — Droparabia</title>
    <link rel="icon" type="image/png" href="/Droparabia.webp" />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      @font-face {
        font-family: 'iBrand';
        src: url('/ibrand-font/ibrand.otf') format('opentype');
        font-weight: normal;
        font-style: normal;
        font-display: block;
      }

      body {
        font-family: 'Inter', system-ui, sans-serif;
        background: #F0F0F0;
        color: #000;
        min-height: 100vh;
        overflow-x: hidden;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
      }

      .text-section {
        padding: 1.25rem 1.25rem 1.5rem;
      }

      .hero-heading {
        font-family: 'iBrand', sans-serif;
        font-size: clamp(2rem, 5vw, 3rem);
        line-height: 1;
        color: #000;
        margin-bottom: 0.75rem;
      }

      .hero-sub {
        font-size: clamp(1rem, 2.5vw, 1.25rem);
        font-weight: 500;
        color: #222;
        line-height: 1.5;
      }

      .guide-image {
        width: auto;
        max-width: 100%;
        max-height: 45vh;
        display: block;
        margin: 0 auto;
        object-fit: contain;
      }

      .btn-section {
        padding: 2.5rem 1.25rem 4rem;
      }

      .dl-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 16px 36px;
        background: #020887;
        color: #fff;
        font-size: 1.05rem;
        font-weight: 600;
        border-radius: 14px;
        text-decoration: none;
        transition: transform 0.15s, box-shadow 0.15s;
        box-shadow: 0 4px 20px rgba(2,8,135,0.30);
      }

      .dl-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 28px rgba(2,8,135,0.40);
      }

      .dl-btn svg { flex-shrink: 0; }
    </style>
  </head>
  <body>
    <div class="text-section">
      <h1 class="hero-heading">As Promised!</h1>
      <p class="hero-sub">7+ Exclusive guides to help you kickstart your high-earning business!</p>
    </div>

    <img class="guide-image" src="/free guides.jpeg" alt="7 Exclusive Droparabia Guides" />

    <div class="btn-section">
      <a class="dl-btn" href="https://drive.google.com/file/d/1U9PrT48Oss-e1b4VqnzMzjzDvFNMgb92/view?usp=sharing" target="_blank" rel="noopener noreferrer">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M10 2v10m0 0l-3-3m3 3l3-3" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M3 14v1a2 2 0 002 2h10a2 2 0 002-2v-1" stroke="#fff" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
        Download All Guides
      </a>
    </div>
  </body>
</html>
