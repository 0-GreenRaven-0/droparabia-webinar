---
// Head tags for the training funnel: GA4 (gtag.js) + Google Tag Manager.
//
// The GTM <noscript> iframe is NOT here — it has to be the first thing inside
// <body>, so each page renders <GtmNoscript /> there.
//
// Custom event this funnel sends on a successful registration (index.astro):
//   lead-registered
// It goes out twice, on purpose, because the two tools listen differently:
//   - gtag('event', 'lead-registered', ...)  -> straight to GA4
//   - dataLayer.push({ event: 'lead-registered' }) -> so a GTM Custom Event
//     trigger can fire on it
// If you later tag it inside GTM as well, remove one of the two or GA4 will
// count the same registration twice.
//
// Note: the older pages (choose-schedule, survey, terms, privacy-policy) load a
// different, older container (GTM-NTGWNM69). This funnel uses GTM-M6Z6BXQQ.
const GA_MEASUREMENT_ID = 'G-KBCL3ELQD7';
const GTM_ID = 'GTM-M6Z6BXQQ';
---

<!-- Google tag (gtag.js) -->
<script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
<script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
  window.dataLayer = window.dataLayer || [];
  function gtag() { dataLayer.push(arguments); }
  window.gtag = gtag;
  gtag('js', new Date());
  gtag('config', GA_MEASUREMENT_ID);
</script>

<!-- Google Tag Manager -->
<script is:inline define:vars={{ GTM_ID }}>
  (function (w, d, s, l, i) {
    w[l] = w[l] || [];
    w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
    var f = d.getElementsByTagName(s)[0],
      j = d.createElement(s),
      dl = l != 'dataLayer' ? '&l=' + l : '';
    j.async = true;
    j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
    f.parentNode.insertBefore(j, f);
  })(window, document, 'script', 'dataLayer', GTM_ID);
</script>
<!-- End Google Tag Manager -->
