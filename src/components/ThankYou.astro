---
// Thank-you page: the pasted Thank_You_Page.html, using its own CSS
// (src/styles/thank-you.css) with Droparabia's palette, fonts and logo swapped in.
//
// Shared body of both routes, so the Meta split survives:
//   /confirm   -> tracked:true  -> pixel loads, fires PageView + Lead
//   /confirm-b -> tracked:false -> no pixel at all
import '../styles/global.css';
import '../styles/thank-you.css';
import Analytics from '../components/Analytics.astro';
import GtmNoscript from '../components/GtmNoscript.astro';
import { WEBINAR_GCAL_URL, WHATSAPP_CHANNEL_URL, SOCIAL_INSTAGRAM, SOCIAL_YOUTUBE } from '../config/webinar';

interface Props { tracked?: boolean; }
const { tracked = false } = Astro.props;

const pixelId = import.meta.env.PUBLIC_META_PIXEL_ID;
const usePixel = tracked && !!pixelId;
---

<html lang="en">
  <head>
    <Analytics />
    <meta charset="utf-8" />
    <title>You're In | Droparabia Free Live Training</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/Droparabia.webp" />
    {usePixel && (
      <script is:inline set:html={`
        !function(f,b,e,v,n,t,s)
        {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};
        if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
        n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t,s)}(window,document,'script',
        'https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', '${pixelId}');
        fbq('track', 'PageView');
        fbq('track', 'Lead');
      `} />
    )}
  </head>
  <body>
    <GtmNoscript />
    {usePixel && (
      <noscript set:html={`<img height="1" width="1" style="display:none" alt="" src="https://www.facebook.com/tr?id=${pixelId}&ev=Lead&noscript=1" />`} />
    )}
<div style="font-family: 'Helvetica', Arial, sans-serif; color: #0D0D2B; background: #FFFFFF; min-height: 100vh">

<!-- No tint and no rule: the header sits on the same surface as the page. -->
<div>
<div class="ty-top" style="max-width: 1240px; margin: 0 auto; padding: 18px 24px; display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap">
<div style="display: flex; align-items: center; gap: 10px">
<img class="ty-logo" src="/Droparabia.webp" alt="" style="width: 40px; height: 40px; object-fit: contain; display: block">
<div class="ty-brand" style="font-size: 22px; letter-spacing: -0.02em; color: #0D0D2B">Droparabia</div>
</div>
<div class="ty-pill" style="background: #001EFF; color: #FFFFFF; font-weight: 700; font-size: 13px; letter-spacing: 0.08em; padding: 9px 16px; border-radius: 999px">FREE LIVE TRAINING</div>
</div>
</div>

<div class="ty-wrap">

<div style="text-align: center; margin-bottom: 28px">
<div class="ty-check" style="width: 76px; height: 76px; margin: 0 auto 18px; border-radius: 999px; background: #001EFF; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 0 8px #E5EDFF">
<svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg>
</div>
<h1 class="ty-h1" style="font-weight: 800; font-size: 44px; line-height: 1.1; letter-spacing: -0.025em; margin: 0 0 12px">You're In<span id="confirm-name"></span>! Here's What To Do Next.</h1>
<p style="font-size: 18px; color: #44506A; margin: 0">Watch this short video from Majd first.</p>
</div>

<div id="video" style="position: relative; aspect-ratio: 16 / 9; border-radius: 16px; overflow: hidden; border: 3px solid #001EFF; background: #0D0D2B; display: flex; align-items: center; justify-content: center; margin-bottom: 40px">
<div style="position: absolute; top: 14px; right: 14px; background: rgba(0,0,0,0.6); color: #FFFFFF; font-size: 14px; padding: 7px 12px; border-radius: 999px">Tap for sound</div>
<div style="display: flex; flex-direction: column; align-items: center; gap: 14px; padding: 0 16px; text-align: center">
<div style="width: 96px; height: 72px; border-radius: 12px; background: #001EFF; display: flex; align-items: center; justify-content: center">
<svg width="34" height="34" viewBox="0 0 24 24" fill="#FFFFFF" aria-hidden="true"><path d="M7 4.5v15l13-7.5z"></path></svg>
</div>
<div style="color: #A9B6D0; font-size: 14px">[VIDEO: Majd thanks them for registering and tells them why they must show up live]</div>
</div>
</div>

<div class="ty-card" style="background: #FFFFFF; border: 1px solid #DDE3F5; border-radius: 18px; padding: 30px 32px; margin-bottom: 64px; box-shadow: 0 10px 30px rgba(0,30,255,0.06)">
<h2 style="font-weight: 800; font-size: 28px; margin: 0 0 24px">Before The Training, Do These 3 Things</h2>
<div style="display: flex; flex-direction: column; gap: 26px">

<div class="ty-step">
<div style="flex: none; width: 32px; height: 32px; border-radius: 999px; background: #001EFF; color: #FFFFFF; font-weight: 800; display: flex; align-items: center; justify-content: center">1</div>
<div style="min-width: 0; flex: 1">
<div style="font-weight: 700; font-size: 19px; margin-bottom: 6px">Join the WhatsApp Channel</div>
<div style="font-size: 16px; line-height: 1.6; color: #44506A">This is where you get the Zoom link, the reminders and a few surprises before the training. Once you join, make sure notifications are on. If you don't, you might miss the link.</div>
<div class="ty-actions"><a class="ty-btn" href={WHATSAPP_CHANNEL_URL || "#"} style="background: #001EFF; color: #FFFFFF; height: 48px; padding: 0 22px; font-size: 16px">Join the WhatsApp Channel</a></div>
</div>
</div>

<div class="ty-step">
<div style="flex: none; width: 32px; height: 32px; border-radius: 999px; background: #001EFF; color: #FFFFFF; font-weight: 800; display: flex; align-items: center; justify-content: center">2</div>
<div style="min-width: 0; flex: 1">
<div style="font-weight: 700; font-size: 19px; margin-bottom: 6px">Save the date in your calendar</div>
<div style="font-size: 16px; line-height: 1.6; color: #44506A">Thursday, October 29 at 8:00 PM. It's live only, with no replay. Block the time now so nothing gets in the way.</div>
<div class="ty-actions"><a class="ty-btn" target="_blank" rel="noopener" href={WEBINAR_GCAL_URL} style="background: #001EFF; color: #FFFFFF; height: 48px; padding: 0 22px; font-size: 16px">Add to Google Calendar</a></div>
</div>
</div>

<div class="ty-step">
<div style="flex: none; width: 32px; height: 32px; border-radius: 999px; background: #001EFF; color: #FFFFFF; font-weight: 800; display: flex; align-items: center; justify-content: center">3</div>
<div style="min-width: 0; flex: 1">
<div style="font-weight: 700; font-size: 19px; margin-bottom: 6px">Follow Majd before the training</div>
<div style="font-size: 16px; line-height: 1.6; color: #44506A">Watch a few videos on Instagram and YouTube so you show up ready. You'll see real users, real stores and how the system works day to day.</div>
<div class="ty-actions">
<a class="ty-btn" target="_blank" rel="noopener" href={SOCIAL_INSTAGRAM} style="background: #001EFF; color: #FFFFFF; height: 48px; padding: 0 22px; font-size: 16px">Instagram</a>
<a class="ty-btn" target="_blank" rel="noopener" href={SOCIAL_YOUTUBE} style="background: #001EFF; color: #FFFFFF; height: 48px; padding: 0 22px; font-size: 16px">YouTube</a>
</div>
</div>
</div>

</div>
</div>

