---
import 'swiper/css';
---

<section class="testo-section">
  <div class="section" style="padding-top: 40px; padding-bottom: 40px;">

    <!-- Header -->
    <div class="text-center mb-14 gs-test-header">
      <h2 class="text-2xl sm:text-5xl font-normal mb-4 text-white">
        Yes It's possible<br/>
        <span class="text-cyan-400">+600 Lebanese</span> already did it
      </h2>
    </div>


    <!-- Swiper Carousel -->
    <div class="carousel-container">
      <button class="swiper-button-prev" aria-label="Previous">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
      </button>
      <button class="swiper-button-next" aria-label="Next">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
      </button>
      <div class="swiper testimonials-swiper">
        <div class="swiper-wrapper">
          {[
            "https://ik.imagekit.io/greenraven/MJ/Case%20Studies/4.png?tr=w-900,q-70,f-webp",
            "https://ik.imagekit.io/greenraven/MJ/Case%20Studies/5.png?tr=w-900,q-70,f-webp",
            "https://ik.imagekit.io/greenraven/MJ/Case%20Studies/2.png?tr=w-900,q-70,f-webp",
            "https://ik.imagekit.io/greenraven/MJ/Case%20Studies/6.png?tr=w-900,q-70,f-webp",
            "https://ik.imagekit.io/greenraven/MJ/Case%20Studies/1.png?tr=w-900,q-70,f-webp",
            "https://ik.imagekit.io/greenraven/MJ/Case%20Studies/3.png?tr=w-900,q-70,f-webp",
            "https://ik.imagekit.io/greenraven/MJ/Testimonials/Testo.png?tr=w-900,q-70,f-webp",
            "https://ik.imagekit.io/greenraven/MJ/Testimonials/Testo%20(1).png?tr=w-900,q-70,f-webp",
            "https://ik.imagekit.io/greenraven/MJ/Testimonials/Testo%20(2)%20(1)%20(1).png?tr=w-900,q-70,f-webp",
            "https://ik.imagekit.io/greenraven/MJ/Testimonials/Testo%20(3).png?tr=w-900,q-70,f-webp",
            "https://ik.imagekit.io/greenraven/MJ/Testimonials/Testo%20(4)%20(1).png?tr=w-900,q-70,f-webp",
            "https://ik.imagekit.io/greenraven/MJ/Testimonials/Testo%20(5).png?tr=w-900,q-70,f-webp",
            "https://ik.imagekit.io/greenraven/MJ/Testimonials/Testo%20(6).png?tr=w-900,q-70,f-webp",
            "https://ik.imagekit.io/greenraven/MJ/Testimonials/Testo%20(7)%20(1)%20(1).png?tr=w-900,q-70,f-webp",
            "https://ik.imagekit.io/greenraven/MJ/Testimonials/Testo%20(8).png?tr=w-900,q-70,f-webp",
            "https://ik.imagekit.io/greenraven/MJ/Testimonials/Testo%20(9)%20(2).png?tr=w-900,q-70,f-webp",
            "https://ik.imagekit.io/greenraven/MJ/Testimonials/Testo%20(10).png?tr=w-900,q-70,f-webp",
            "https://ik.imagekit.io/greenraven/MJ/Testimonials/Testo%20(11).png?tr=w-900,q-70,f-webp",
            "https://ik.imagekit.io/greenraven/MJ/Testimonials/Testo%20(12).png?tr=w-900,q-70,f-webp",
          ].map((src) => (
            <div class="swiper-slide">
              <img src={src} alt="Testimonial" loading="lazy" />
            </div>
          ))}
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .carousel-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 76px;
    position: relative;
  }

  .testimonials-swiper {
    padding-bottom: 0;
  }

  .testimonials-swiper .swiper-slide {
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(0,0,0,0.15);
  }

  .testimonials-swiper .swiper-slide img {
    width: 100%;
    height: auto;
    display: block;
  }

  .carousel-container .swiper-button-prev,
  .carousel-container .swiper-button-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 56px;
    height: 56px;
    background: #2B9FD9;
    color: #fff;
    border-radius: 50%;
    border: none;
    outline: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    transition: background 0.2s, color 0.2s;
  }

  .carousel-container .swiper-button-prev { left: 4px; }
  .carousel-container .swiper-button-next { right: 4px; }

  .carousel-container .swiper-button-prev::after,
  .carousel-container .swiper-button-next::after {
    display: none;
  }

  .carousel-container .swiper-button-prev svg,
  .carousel-container .swiper-button-next svg {
    width: 26px;
    height: 26px;
    display: block;
  }

  .carousel-container .swiper-button-prev:hover,
  .carousel-container .swiper-button-next:hover {
    background: #2B9FD9;
    color: #fff;
  }

  .testo-section {
    background: linear-gradient(135deg, #000c3d 0%, #001575 45%, #002199 70%, #001060 100%);
  }

  @media (max-width: 768px) {
    .testo-section {
      background: #F0F0F0;
    }
    .carousel-container {
      padding: 0 32px;
    }
    .carousel-container .swiper-button-prev,
    .carousel-container .swiper-button-next {
      width: 40px;
      height: 40px;
    }
    .carousel-container .swiper-button-prev svg,
    .carousel-container .swiper-button-next svg {
      width: 20px;
      height: 20px;
    }
  }
</style>

<script>
  async function initSwipers() {
    const [{ default: Swiper }, { Navigation, Autoplay }] = await Promise.all([
      import('swiper'),
      import('swiper/modules'),
    ]);

    document.querySelectorAll('.testimonials-swiper').forEach((swiperEl) => {
      const container = swiperEl.closest('.carousel-container');
      if (!container) return;
      new Swiper(swiperEl as HTMLElement, {
        modules: [Navigation, Autoplay],
        slidesPerView: 1,
        spaceBetween: 16,
        breakpoints: {
          600: { slidesPerView: 2, spaceBetween: 20 },
          1024: { slidesPerView: 3, spaceBetween: 24 },
        },
        loop: true,
        autoplay: {
          delay: 3500,
          disableOnInteraction: false,
          pauseOnMouseEnter: true,
        },
        navigation: {
          nextEl: container.querySelector('.swiper-button-next') as HTMLElement,
          prevEl: container.querySelector('.swiper-button-prev') as HTMLElement,
        },
        pagination: false,
      });
    });
  }

  const swiperEls = document.querySelectorAll('.testimonials-swiper');
  if (swiperEls.length && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries, obs) => {
      if (entries.some((entry) => entry.isIntersecting)) {
        obs.disconnect();
        initSwipers();
      }
    }, { rootMargin: '200px' });
    swiperEls.forEach((el) => observer.observe(el));
  } else {
    initSwipers();
  }
</script>
