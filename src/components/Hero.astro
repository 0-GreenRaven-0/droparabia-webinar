---
import FlipClock from './FlipClock.astro';
---

<section class="hero">

  <!-- Left: white panel -->
  <div class="hero-left">
    <div class="logo">
      <img src="/Droparabia.png" alt="Droparabia" />
      <span>Droparabia</span>
    </div>

    <!-- Parachutes -->
    <div class="parachutes" aria-hidden="true">
      <img class="parachute p1" src="/dropship.png" alt="" />
      <img class="parachute p2" src="/dropship.png" alt="" />
      <img class="parachute p3" src="/dropship.png" alt="" />
    </div>

    <!-- City skyline -->
    <img class="skyline" src="/city.png" alt="" />
  </div>

  <!-- Right: navy panel -->
  <div class="hero-right">
    <div class="hero-headline">
      <h1>The best low budget Business model<br>to make your first <span class="h1-accent">$2,000 – $3,000</span></h1>
      <div class="sub">Followed by +500 Lebanese despite the on-going tensions</div>
      <div class="surprise">All will be revealed in this Free Live Workshop + A surprise worth $997 for those who stay until the very end!</div>
    </div>

    <div class="countdown-block">
      <div class="clock-wrap">
        <FlipClock targetDate="2026-06-01 20:00:00" />
      </div>
      <a href="#register" class="cta-btn">Secure Your Spot Now!</a>
      <div class="cta-fineprint">Replays aren't guaranteed so make sure you don't miss out!</div>
    </div>
  </div>

</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    min-height: 580px;
    background: #fff;
    display: flex;
    overflow: hidden;
  }

  /* Left white panel */
  .hero-left {
    position: relative;
    flex: 0 0 39%;
    min-height: 580px;
    background: #fff;
    overflow: hidden;
  }

  .logo {
    position: absolute;
    left: 24px;
    top: 18px;
    display: flex;
    align-items: center;
    gap: 8px;
    z-index: 5;
  }
  .logo img {
    width: 72px;
    height: 72px;
    object-fit: contain;
  }
  .logo span {
    font-family: 'IBrand', sans-serif;
    font-size: 36px;
    color: #000;
    letter-spacing: -0.01em;
  }

  .skyline {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: auto;
    pointer-events: none;
  }

  .parachutes {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .parachute {
    position: absolute;
    width: 130px;
    height: auto;
    animation: bob 7s ease-in-out infinite;
  }
  .parachute.p1 { left: 10%; top: 22%; animation-delay: 0s; }
  .parachute.p2 { left: 38%; top: 12%; width: 150px; animation-delay: -2.4s; }
  .parachute.p3 { left: 65%; top: 24%; width: 130px; animation-delay: -4.5s; }

  @keyframes bob {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(14px); }
  }

  /* Right navy panel */
  .hero-right {
    flex: 1;
    background: linear-gradient(135deg, #000c3d 0%, #001575 45%, #002199 70%, #001060 100%);
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 60px 50px;
    overflow: hidden;
  }

  .hero-headline {
    text-align: center;
    color: #fff;
    max-width: 860px;
  }
  .hero-headline h1 {
    margin: 0;
    font-family: 'IBrand', sans-serif;
    font-weight: 400;
    font-size: clamp(28px, 3vw, 42px);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: #fff;
    transform: scale(1.18);
    transform-origin: center top;
  }
  .h1-accent {
    color: #00D4FF;
  }
  .hero-headline .sub {
    margin-top: 18px;
    font-family: 'IBrand', sans-serif;
    font-weight: 400;
    font-size: clamp(18px, 2vw, 26px);
    line-height: 1.25;
    color: #fff;
  }
  .hero-headline .surprise {
    margin-top: 28px;
    font-family: 'Inter', sans-serif;
    font-weight: 400;
    font-size: clamp(14px, 1.3vw, 18px);
    line-height: 1.4;
    color: #fff;
  }

  .countdown-block {
    margin-top: 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    color: #fff;
  }

  .countdown {
    font-family: 'IBrand', sans-serif;
    display: inline-flex;
    gap: 14px;
    align-items: flex-start;
  }
  .unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
  }
  .num {
    font-size: clamp(32px, 3.5vw, 44px);
    line-height: 1;
    color: #fff;
  }
  .lbl {
    font-family: 'Outfit', sans-serif;
    font-weight: 500;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.7);
    margin-top: 4px;
  }
  .colon {
    font-size: clamp(32px, 3.5vw, 44px);
    line-height: 1;
    color: rgba(255,255,255,0.55);
    margin-top: -2px;
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgb(20, 173, 0);
    color: #fff;
    font-family: 'IBrand', sans-serif;
    font-size: 22px;
    letter-spacing: -0.01em;
    border-radius: 18px;
    padding: 18px 56px;
    text-decoration: none;
    box-shadow: 0 6px 0 rgb(7, 97, 12), 0 14px 28px rgba(0,0,0,0.25);
    transition: transform .12s ease, box-shadow .12s ease;
  }
  .cta-btn:hover {
    transform: translateY(2px);
    box-shadow: 0 4px 0 rgb(7, 97, 12), 0 10px 22px rgba(0,0,0,0.3);
  }
  .cta-btn:active {
    transform: translateY(6px);
    box-shadow: none;
  }

  .cta-fineprint {
    font-family: 'IBrand', sans-serif;
    font-size: 15px;
    color: rgba(255,255,255,0.85);
  }

  @media (max-width: 768px) {
    .hero {
      flex-direction: column;
      min-height: auto;
      overflow: hidden;
    }
    .hero-left {
      flex: 0 0 200px;
      width: 100%;
      min-height: 200px;
    }
    .logo { left: 16px; top: 12px; }
    .logo span { font-size: 22px; }
    .logo img  { width: 40px; height: 40px; }
    .skyline { width: 55%; left: 22%; }
    .parachute { width: 60px !important; }
    .parachute.p1 { top: 35% !important; }
    .parachute.p2 { top: 15% !important; }
    .parachute.p3 { top: 39% !important; }
    .hero-right {
      flex: 1;
      padding: 28px 8px 36px;
      width: 100%;
    }
    .hero-headline {
      max-width: 100%;
      width: 100%;
    }
    .hero-headline h1 {
      font-size: 18px;
      transform: scale(1.2);
      transform-origin: center top;
      overflow-wrap: break-word;
      margin-bottom: 10px;
    }
    .hero-headline .sub      { font-size: 14px; margin-top: 12px; }
    .hero-headline .surprise  { font-size: 12px; margin-top: 14px; }
    .countdown-block { margin-top: 20px; gap: 10px; }
    .clock-wrap {
      transform: scale(0.6);
      transform-origin: center top;
      margin-bottom: -36px;
    }
    .cta-btn {
      font-size: 16px;
      padding: 12px 28px;
      width: auto;
      align-self: center;
    }
    .cta-fineprint { font-size: 11px; }
  }
</style>

